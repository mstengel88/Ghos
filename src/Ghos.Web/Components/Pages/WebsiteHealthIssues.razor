@page "/website-health/issues"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GhosPolicies.WebsiteHealth)]
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject WebsiteHealthIssueService IssueService
@inject WebsiteHealthRunCoordinator RunCoordinator
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<WebsiteHealthIssues> Logger

<PageTitle>Website Health Issues | GHOS</PageTitle>

<div class="issue-heading">
    <div>
        <a href="/website-health">← Website Health Center</a>
        <span class="panel-label">ISSUE OPERATIONS</span>
        <h2>Website issues</h2>
        <p>Prioritize findings, document ownership, and suppress known exceptions without losing history.</p>
    </div>
    <div class="issue-heading-actions">
        <span class="last-refresh">Latest crawl data</span>
        <button type="button"
                disabled="@(Busy || Issues.Count == 0)"
                @onclick="DownloadFixListAsync">
            Download fix list
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="issue-alert error" role="alert">@ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="issue-alert success" role="status">@SuccessMessage</div>
}

@if (Loading)
{
    <section class="panel issue-loading">Loading website issues…</section>
}
else
{
    <section class="issue-summary">
        <article class="panel">
            <span>Open</span>
            <strong>@Issues.Count(IsOpen)</strong>
            <small>Unacknowledged findings</small>
        </article>
        <article class="panel">
            <span>Acknowledged</span>
            <strong>@Issues.Count(IsAcknowledged)</strong>
            <small>Reviewed and assigned</small>
        </article>
        <article class="panel">
            <span>Suppressed</span>
            <strong>@Issues.Count(IsSuppressed)</strong>
            <small>Known exceptions</small>
        </article>
        <article class="panel">
            <span>Resolved</span>
            <strong>@Issues.Count(IsResolved)</strong>
            <small>Cleared by a later crawl</small>
        </article>
    </section>

    <section class="panel issue-controls">
        <div class="status-tabs" role="group" aria-label="Issue status filter">
            @foreach (var view in Enum.GetValues<IssueView>())
            {
                <button class="@(SelectedView == view ? "active" : "")"
                        type="button"
                        @onclick="() => SelectedView = view">
                    @FormatView(view)
                </button>
            }
        </div>
        <div class="filter-fields">
            <label>
                <span>Finding type</span>
                <select @bind="SelectedCheckKey">
                    <option value="">All finding types</option>
                    @foreach (var key in Issues
                        .Select(issue => issue.CheckKey)
                        .Distinct()
                        .OrderBy(key => key))
                    {
                        <option value="@key">@FormatCheckKey(key)</option>
                    }
                </select>
            </label>
            <label>
                <span>Search</span>
                <input @bind="Search"
                       @bind:event="oninput"
                       type="search"
                       placeholder="Title or affected URL" />
            </label>
        </div>
    </section>

    var filteredIssues = GetFilteredIssues();
    <section class="panel issue-results">
        <div class="results-heading">
            <div>
                <span class="panel-label">FINDINGS</span>
                <h3>@filteredIssues.Count issue@(filteredIssues.Count == 1 ? "" : "s")</h3>
            </div>
            <span>Grouped by type and affected page</span>
        </div>

        @if (filteredIssues.Count == 0)
        {
            <div class="issue-empty">
                <strong>No issues match these filters</strong>
                <span>Change the status, finding type, or search text.</span>
            </div>
        }
        else
        {
            <div class="issue-groups">
                @foreach (var group in filteredIssues
                    .GroupBy(issue => issue.CheckKey)
                    .OrderByDescending(group => group.Max(issue => issue.Severity))
                    .ThenByDescending(group => group.Count()))
                {
                    <section class="issue-group">
                        <header>
                            <div>
                                <span class="type-icon">@IssueIcon(group.Key)</span>
                                <div>
                                    <strong>@FormatCheckKey(group.Key)</strong>
                                    <small>@group.Count() finding@(group.Count() == 1 ? "" : "s")</small>
                                </div>
                            </div>
                            <span class="severity @group.Max(issue => issue.Severity).ToString().ToLowerInvariant()">
                                @group.Max(issue => issue.Severity)
                            </span>
                        </header>

                        @foreach (var issue in group.OrderByDescending(item => item.LastDetectedAtUtc))
                        {
                            <article class="finding-row">
                                <div class="finding-main">
                                    <div class="finding-title">
                                        <strong>@issue.Title</strong>
                                        <span class="state @GetIssueState(issue).ToLowerInvariant()">
                                            @GetIssueState(issue)
                                        </span>
                                    </div>
                                    <p>@issue.Description</p>
                                    @if (!string.IsNullOrWhiteSpace(issue.AffectedUrl))
                                    {
                                        <a href="@issue.AffectedUrl"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            @issue.AffectedUrl ↗
                                        </a>
                                    }
                                    <div class="finding-meta">
                                        <span>First seen @FormatDate(issue.FirstDetectedAtUtc)</span>
                                        <span>Last seen @FormatDate(issue.LastDetectedAtUtc)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(issue.Recommendation))
                                    {
                                        <section class="recommendation">
                                            <div>
                                                <span>RECOMMENDED FIX</span>
                                                <strong>What to change</strong>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(issue.FixLocation))
                                            {
                                                <div class="fix-location">
                                                    <span>WHERE TO MAKE THIS CHANGE</span>
                                                    <strong>@issue.FixLocation</strong>
                                                    @if (!string.IsNullOrWhiteSpace(issue.FixDocumentationUrl))
                                                    {
                                                        <a href="@issue.FixDocumentationUrl"
                                                           target="_blank"
                                                           rel="noopener noreferrer">
                                                            Official Shopify instructions ↗
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            <p>@issue.Recommendation</p>
                                            @if (!string.IsNullOrWhiteSpace(issue.SuggestedValue))
                                            {
                                                <div class="value-comparison @(
                                                    string.IsNullOrWhiteSpace(issue.CurrentValue)
                                                        ? "single"
                                                        : "")">
                                                    @if (!string.IsNullOrWhiteSpace(issue.CurrentValue))
                                                    {
                                                        <div class="current-value">
                                                            <div>
                                                                <span>CURRENT LIVE VALUE</span>
                                                                <small>@CharacterCount(issue.CurrentValue)</small>
                                                            </div>
                                                            <pre>@issue.CurrentValue</pre>
                                                        </div>
                                                    }
                                                    <div class="suggested-value">
                                                        <div>
                                                            <span>@SuggestionLabel(issue.CheckKey)</span>
                                                            <small>@CharacterCount(issue.SuggestedValue)</small>
                                                            <button type="button"
                                                                    disabled="@Busy"
                                                                    @onclick="() => CopySuggestionAsync(issue)">
                                                                Copy suggestion
                                                            </button>
                                                        </div>
                                                        <pre>@issue.SuggestedValue</pre>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(issue.SuggestedValue) ||
                                                !string.IsNullOrWhiteSpace(issue.ReviewedValue))
                                            {
                                                <AuthorizeView Policy="@GhosPolicies.WebsiteHealthManage">
                                                    <Authorized>
                                                        <div class="reviewed-editor">
                                                            <div class="reviewed-heading">
                                                                <div>
                                                                    <span>REVIEWED WORKING COPY</span>
                                                                    @if (issue.ReviewedAtUtc is not null)
                                                                    {
                                                                        <small>
                                                                            Saved @FormatDate(issue.ReviewedAtUtc.Value)
                                                                        </small>
                                                                    }
                                                                    else
                                                                    {
                                                                        <small>
                                                                            Edit the scanner suggestion, then save your final wording.
                                                                        </small>
                                                                    }
                                                                </div>
                                                                <small>@CharacterCount(GetReviewedDraft(issue))</small>
                                                            </div>
                                                            <textarea value="@GetReviewedDraft(issue)"
                                                                      @oninput="eventArgs => SetReviewedDraft(
                                                                          issue.Id,
                                                                          eventArgs.Value?.ToString())"
                                                                      maxlength="6000"
                                                                      rows="4"
                                                                      aria-label="Reviewed working copy"></textarea>
                                                            <div class="reviewed-actions">
                                                                <button type="button"
                                                                        disabled="@Busy"
                                                                        @onclick="() => SaveReviewedValueAsync(issue)">
                                                                    Save reviewed copy
                                                                </button>
                                                                <button type="button"
                                                                        disabled="@Busy"
                                                                        @onclick="() => CopyReviewedDraftAsync(issue)">
                                                                    Copy reviewed copy
                                                                </button>
                                                                @if (issue.ReviewedValue is not null)
                                                                {
                                                                    <button class="reset"
                                                                            type="button"
                                                                            disabled="@Busy"
                                                                            @onclick="() => ClearReviewedValueAsync(issue)">
                                                                        Reset to scanner suggestion
                                                                    </button>
                                                                }
                                                            </div>
                                                        </div>
                                                    </Authorized>
                                                    <NotAuthorized>
                                                        @if (!string.IsNullOrWhiteSpace(issue.ReviewedValue))
                                                        {
                                                            <div class="reviewed-readonly">
                                                                <div>
                                                                    <span>REVIEWED WORKING COPY</span>
                                                                    <small>
                                                                        Saved @FormatDate(issue.ReviewedAtUtc!.Value)
                                                                    </small>
                                                                </div>
                                                                <pre>@issue.ReviewedValue</pre>
                                                                <button type="button"
                                                                        disabled="@Busy"
                                                                        @onclick="() => CopyReviewedValueAsync(issue)">
                                                                    Copy reviewed copy
                                                                </button>
                                                            </div>
                                                        }
                                                    </NotAuthorized>
                                                </AuthorizeView>
                                            }
                                        </section>
                                    }
                                </div>

                                <AuthorizeView Policy="@GhosPolicies.WebsiteHealthManage">
                                    <div class="triage-controls">
                                        <input value="@GetNote(issue)"
                                               @onchange="eventArgs => SetNote(issue.Id, eventArgs.Value?.ToString())"
                                               maxlength="1000"
                                               placeholder="Optional triage note" />
                                        <div>
                                            @if (issue.ResolvedAtUtc is null && issue.SuppressedAtUtc is null)
                                            {
                                                <button class="verify"
                                                        type="button"
                                                        disabled="@Busy"
                                                        title="Run a fresh live scan and confirm whether this issue is fixed"
                                                        @onclick="() => VerifyFixAsync(issue)">
                                                    @(VerifyingIssueId == issue.Id
                                                        ? "Checking live site…"
                                                        : "Verify fix")
                                                </button>
                                                @if (issue.AcknowledgedAtUtc is null)
                                                {
                                                    <button type="button"
                                                            disabled="@Busy"
                                                            @onclick="() => UpdateIssueAsync(issue, WebsiteHealthIssueAction.Acknowledge)">
                                                        Acknowledge
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            disabled="@Busy"
                                                            @onclick="() => UpdateIssueAsync(issue, WebsiteHealthIssueAction.ClearAcknowledgement)">
                                                        Reopen
                                                    </button>
                                                }
                                                <button class="suppress"
                                                        type="button"
                                                        disabled="@Busy"
                                                        title="Hide this known exception from the active dashboard"
                                                        @onclick="() => UpdateIssueAsync(issue, WebsiteHealthIssueAction.Suppress)">
                                                    Suppress
                                                </button>
                                            }
                                            else if (issue.SuppressedAtUtc is not null)
                                            {
                                                <button type="button"
                                                        disabled="@Busy"
                                                        @onclick="() => UpdateIssueAsync(issue, WebsiteHealthIssueAction.Restore)">
                                                    Restore
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </AuthorizeView>
                            </article>
                        }
                    </section>
                }
            </div>
        }
    </section>
}

@code {
    private List<WebsiteHealthIssue> Issues { get; set; } = [];
    private Dictionary<Guid, string?> Notes { get; } = [];
    private Dictionary<Guid, string?> ReviewedDrafts { get; } = [];
    private IssueView SelectedView { get; set; } = IssueView.Active;
    private string SelectedCheckKey { get; set; } = "";
    private string Search { get; set; } = "";
    private bool Loading { get; set; } = true;
    private bool Busy { get; set; }
    private Guid? VerifyingIssueId { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var dbContext =
            await DbContextFactory.CreateDbContextAsync();
        Issues = await dbContext.WebsiteHealthIssues
            .AsNoTracking()
            .OrderByDescending(issue => issue.LastDetectedAtUtc)
            .Take(500)
            .ToListAsync();
        Notes.Clear();
        ReviewedDrafts.Clear();
        foreach (var issue in Issues)
        {
            Notes[issue.Id] = issue.TriageNote;
            ReviewedDrafts[issue.Id] =
                issue.ReviewedValue ?? issue.SuggestedValue;
        }

        Loading = false;
    }

    private List<WebsiteHealthIssue> GetFilteredIssues()
    {
        var query = Issues.Where(issue => SelectedView switch
        {
            IssueView.Active => IsOpen(issue) || IsAcknowledged(issue),
            IssueView.Open => IsOpen(issue),
            IssueView.Acknowledged => IsAcknowledged(issue),
            IssueView.Suppressed => IsSuppressed(issue),
            IssueView.Resolved => IsResolved(issue),
            _ => true
        });
        if (!string.IsNullOrWhiteSpace(SelectedCheckKey))
        {
            query = query.Where(issue =>
                issue.CheckKey == SelectedCheckKey);
        }

        if (!string.IsNullOrWhiteSpace(Search))
        {
            query = query.Where(issue =>
                issue.Title.Contains(
                    Search,
                    StringComparison.OrdinalIgnoreCase) ||
                (issue.AffectedUrl?.Contains(
                    Search,
                    StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return query.ToList();
    }

    private async Task UpdateIssueAsync(
        WebsiteHealthIssue issue,
        WebsiteHealthIssueAction action)
    {
        Busy = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrWhiteSpace(userId))
            {
                ErrorMessage = "Your session could not be verified.";
                return;
            }

            var updated = await IssueService.UpdateAsync(
                issue.Id,
                action,
                userId,
                GetNote(issue));
            if (!updated)
            {
                ErrorMessage = "This issue no longer exists.";
                return;
            }

            SuccessMessage = action switch
            {
                WebsiteHealthIssueAction.Acknowledge => "Issue acknowledged.",
                WebsiteHealthIssueAction.ClearAcknowledgement => "Issue returned to the open queue.",
                WebsiteHealthIssueAction.Suppress => "Issue suppressed as a known exception.",
                WebsiteHealthIssueAction.Restore => "Issue restored to the active queue.",
                _ => "Issue updated."
            };
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to update Website Health issue {IssueId}.",
                issue.Id);
            ErrorMessage = "The issue could not be updated.";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CopySuggestionAsync(WebsiteHealthIssue issue)
    {
        if (string.IsNullOrWhiteSpace(issue.SuggestedValue))
        {
            return;
        }

        ErrorMessage = null;
        try
        {
            await JS.InvokeVoidAsync(
                "ghos.copyText",
                issue.SuggestedValue);
            SuccessMessage = $"{SuggestionLabel(issue.CheckKey)} copied.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Unable to copy Website Health suggestion for issue {IssueId}.",
                issue.Id);
            ErrorMessage =
                "The suggestion could not be copied automatically. Select the text and copy it manually.";
        }
    }

    private async Task SaveReviewedValueAsync(WebsiteHealthIssue issue)
    {
        var draft = GetReviewedDraft(issue);
        if (string.IsNullOrWhiteSpace(draft))
        {
            ErrorMessage =
                "Enter a reviewed value before saving.";
            return;
        }

        Busy = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var userId = await GetCurrentUserIdAsync();
            if (userId is null)
            {
                ErrorMessage = "Your session could not be verified.";
                return;
            }

            if (!await IssueService.SaveReviewedValueAsync(
                issue.Id,
                userId,
                draft))
            {
                ErrorMessage =
                    "The reviewed copy could not be saved.";
                return;
            }

            SuccessMessage =
                "Reviewed copy saved. Future scans will not overwrite it.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to save reviewed Website Health value for issue {IssueId}.",
                issue.Id);
            ErrorMessage =
                "The reviewed copy could not be saved.";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ClearReviewedValueAsync(WebsiteHealthIssue issue)
    {
        Busy = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            if (!await IssueService.ClearReviewedValueAsync(issue.Id))
            {
                ErrorMessage =
                    "The reviewed copy could not be reset.";
                return;
            }

            SuccessMessage =
                "Reviewed copy reset to the latest scanner suggestion.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to reset reviewed Website Health value for issue {IssueId}.",
                issue.Id);
            ErrorMessage =
                "The reviewed copy could not be reset.";
        }
        finally
        {
            Busy = false;
        }
    }

    private Task CopyReviewedDraftAsync(WebsiteHealthIssue issue) =>
        CopyReviewedTextAsync(issue, GetReviewedDraft(issue));

    private Task CopyReviewedValueAsync(WebsiteHealthIssue issue) =>
        CopyReviewedTextAsync(issue, issue.ReviewedValue);

    private async Task CopyReviewedTextAsync(
        WebsiteHealthIssue issue,
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            ErrorMessage =
                "There is no reviewed wording to copy.";
            return;
        }

        ErrorMessage = null;
        try
        {
            await JS.InvokeVoidAsync("ghos.copyText", value);
            SuccessMessage = "Reviewed copy copied.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Unable to copy reviewed Website Health value for issue {IssueId}.",
                issue.Id);
            ErrorMessage =
                "The reviewed copy could not be copied automatically. Select the text and copy it manually.";
        }
    }

    private async Task DownloadFixListAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        var filteredIssues = GetFilteredIssues();
        if (filteredIssues.Count == 0)
        {
            ErrorMessage =
                "No issues match the current filters. Change the filters before downloading.";
            return;
        }

        try
        {
            var csv = WebsiteHealthIssueExportBuilder.BuildCsv(
                filteredIssues);
            var filename =
                $"ghos-website-fixes-{DateTime.Now:yyyy-MM-dd}.csv";
            await JS.InvokeVoidAsync(
                "ghos.downloadText",
                filename,
                csv,
                "text/csv;charset=utf-8");
            SuccessMessage =
                $"Downloaded {filteredIssues.Count} filtered issue" +
                $"{(filteredIssues.Count == 1 ? "" : "s")}.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Unable to export Website Health issues.");
            ErrorMessage =
                "The fix list could not be downloaded. Try again.";
        }
    }

    private async Task VerifyFixAsync(WebsiteHealthIssue issue)
    {
        if (Busy)
        {
            return;
        }

        Busy = true;
        VerifyingIssueId = issue.Id;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrWhiteSpace(userId))
            {
                ErrorMessage = "Your session could not be verified.";
                return;
            }

            var run = await RunCoordinator.TryRunAsync(
                issue.MonitoredSiteId,
                "Issue verification",
                userId);
            if (run is null)
            {
                ErrorMessage =
                    "Another website health check is already running. Try again when it finishes.";
                return;
            }

            if (run.Status == WebsiteHealthRunStatus.Failed)
            {
                ErrorMessage = run.ErrorMessage ??
                    "The live website check could not be completed.";
                return;
            }

            await LoadAsync();
            var refreshedIssue = Issues.FirstOrDefault(
                candidate => candidate.Id == issue.Id);
            SuccessMessage = refreshedIssue?.ResolvedAtUtc is not null
                ? "Fix verified. This issue is now resolved."
                : "Live check complete. This issue is still present; review the saved suggestion and Shopify location.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to verify Website Health issue {IssueId}.",
                issue.Id);
            ErrorMessage =
                "GHOS could not verify the fix. No issue status was changed.";
        }
        finally
        {
            VerifyingIssueId = null;
            Busy = false;
        }
    }

    private string? GetNote(WebsiteHealthIssue issue) =>
        Notes.GetValueOrDefault(issue.Id);

    private void SetNote(Guid issueId, string? note) =>
        Notes[issueId] = note;

    private string GetReviewedDraft(WebsiteHealthIssue issue) =>
        ReviewedDrafts.GetValueOrDefault(issue.Id) ?? "";

    private void SetReviewedDraft(Guid issueId, string? value) =>
        ReviewedDrafts[issueId] = value;

    private async Task<string?> GetCurrentUserIdAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authenticationState.User.FindFirst(
            ClaimTypes.NameIdentifier)?.Value;
    }

    private static bool IsOpen(WebsiteHealthIssue issue) =>
        issue.ResolvedAtUtc is null &&
        issue.SuppressedAtUtc is null &&
        issue.AcknowledgedAtUtc is null;

    private static bool IsAcknowledged(WebsiteHealthIssue issue) =>
        issue.ResolvedAtUtc is null &&
        issue.SuppressedAtUtc is null &&
        issue.AcknowledgedAtUtc is not null;

    private static bool IsSuppressed(WebsiteHealthIssue issue) =>
        issue.ResolvedAtUtc is null &&
        issue.SuppressedAtUtc is not null;

    private static bool IsResolved(WebsiteHealthIssue issue) =>
        issue.ResolvedAtUtc is not null;

    private static string GetIssueState(WebsiteHealthIssue issue) =>
        IsResolved(issue) ? "Resolved" :
        IsSuppressed(issue) ? "Suppressed" :
        IsAcknowledged(issue) ? "Acknowledged" :
        "Open";

    private static string FormatCheckKey(string key) => key switch
    {
        "image-alt" => "Missing image alt text",
        "meta-description" => "Missing meta descriptions",
        "meta-description-length" => "Meta description length",
        "duplicate-meta-description" => "Duplicate meta descriptions",
        "title" => "Missing page titles",
        "title-length" => "Page title length",
        "duplicate-title" => "Duplicate page titles",
        "canonical" => "Missing canonical URLs",
        "schema" => "Missing structured data",
        "internal-link" => "Broken internal links",
        "ssl" => "SSL certificate",
        _ => key.Replace('-', ' ')
    };

    private static string IssueIcon(string key) => key switch
    {
        "image-alt" => "IM",
        "meta-description" => "MD",
        "meta-description-length" => "ML",
        "duplicate-meta-description" => "DM",
        "title-length" => "TL",
        "duplicate-title" => "DT",
        "internal-link" => "↗",
        "ssl" => "◇",
        _ => "!"
    };

    private static string SuggestionLabel(string key) => key switch
    {
        "title" => "SUGGESTED TITLE",
        "title-length" => "SUGGESTED TITLE",
        "duplicate-title" => "SUGGESTED TITLE",
        "meta-description" => "SUGGESTED DESCRIPTION",
        "meta-description-length" => "SUGGESTED DESCRIPTION",
        "duplicate-meta-description" => "SUGGESTED DESCRIPTION",
        "image-alt" => "SUGGESTED ALT TEXT",
        "canonical" => "SUGGESTED CANONICAL TAG",
        "schema" => "SUGGESTED JSON-LD",
        "robots" => "SUGGESTED ROBOTS.TXT",
        "internal-link" => "AFFECTED TARGET",
        _ => "SUGGESTED VALUE"
    };

    private static string FormatDate(DateTime date) =>
        date.ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    private static string CharacterCount(string value) =>
        $"{value.Length} character{(value.Length == 1 ? "" : "s")}";

    private static string FormatView(IssueView view) => view switch
    {
        IssueView.Active => "Active",
        IssueView.Open => "Open",
        IssueView.Acknowledged => "Acknowledged",
        IssueView.Suppressed => "Suppressed",
        IssueView.Resolved => "Resolved",
        _ => "All"
    };

    private enum IssueView
    {
        Active,
        Open,
        Acknowledged,
        Suppressed,
        Resolved,
        All
    }
}
