@page "/quotes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GhosPolicies.Operations)]
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject DispatchQuoteDataSyncService DispatchQuoteDataSyncService
@inject ShopifySyncService ShopifySyncService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Quotes | GHOS</PageTitle>

<div class="quotes-heading">
    <div>
        <span class="panel-label">SALES WORKSPACE</span>
        <h2>Quotes</h2>
        <p>Create, review, and track Green Hills customer and contractor quotes.</p>
    </div>
    <div>
        @if (!string.IsNullOrWhiteSpace(SyncMessage))
        {
            <span class="sync-message">@SyncMessage</span>
        }
        <button type="button"
                class="secondary-action sync-action"
                disabled="@Syncing"
                @onclick="RefreshAllAsync">
            @(Syncing ? "Refreshing…" : "Refresh quote data")
        </button>
        <a class="secondary-action" href="/project-tools">Material calculator</a>
        <a class="primary-action" href="/quotes/new">+ New quote</a>
    </div>
</div>

@if (Loading)
{
    <section class="panel quotes-empty">Loading quotes…</section>
}
else
{
    <section class="quote-summary">
        <article>
            <span>Drafts</span>
            <strong>@QuoteItems.Count(quote => quote.Status == QuoteStatus.Draft)</strong>
        </article>
        <article>
            <span>Ready / sent</span>
            <strong>@QuoteItems.Count(quote =>
                quote.Status is QuoteStatus.ReadyForReview or QuoteStatus.Sent)</strong>
        </article>
        <article>
            <span>Accepted</span>
            <strong>@QuoteItems.Count(quote => quote.Status == QuoteStatus.Accepted)</strong>
        </article>
        <article>
            <span>Quoted value</span>
            <strong>@QuoteItems.Where(quote =>
                    quote.Status is not QuoteStatus.Declined and not QuoteStatus.Expired)
                .Sum(quote => quote.Total).ToString("C0")</strong>
        </article>
    </section>

    <section class="panel quote-list">
        <div class="quote-toolbar">
            <label>
                <span>Search quotes</span>
                <input @bind="SearchText"
                       @bind:event="oninput"
                       placeholder="Quote, customer, company…" />
            </label>
            <label>
                <span>Status</span>
                <select @bind="StatusFilter">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<QuoteStatus>())
                    {
                        <option value="@status">@GetStatusLabel(status)</option>
                    }
                </select>
            </label>
        </div>

        @if (VisibleQuotes.Count == 0)
        {
            <div class="quotes-empty">
                <div class="empty-icon">＄</div>
                <h3>No quotes found</h3>
                <p>Start with the material calculator or create a blank quote.</p>
                <a class="primary-action" href="/quotes/new">Create a quote</a>
            </div>
        }
        else
        {
            <div class="quote-table">
                <div class="quote-row table-head">
                    <span>Quote</span>
                    <span>Customer</span>
                    <span>Updated</span>
                    <span>Lines</span>
                    <span>Total</span>
                    <span>Status</span>
                </div>
                @foreach (var quote in VisibleQuotes)
                {
                    <a class="quote-row" href="/quotes/@quote.Id">
                        <span>
                            <strong>@quote.QuoteNumber</strong>
                            <small>@(quote.IsContractor ? "Contractor" : "Customer")</small>
                        </span>
                        <span>
                            <strong>@(string.IsNullOrWhiteSpace(quote.CustomerName)
                                ? "Unnamed draft"
                                : quote.CustomerName)</strong>
                            <small>@quote.CompanyName</small>
                        </span>
                        <span>
                            <strong>@quote.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</strong>
                            <small>@quote.UpdatedAtUtc.ToLocalTime().ToString("h:mm tt")</small>
                        </span>
                        <span>@quote.Lines.Count</span>
                        <span><strong>@quote.Total.ToString("C2")</strong></span>
                        <span class="status-pill @GetStatusClass(quote.Status)">
                            @GetStatusLabel(quote.Status)
                        </span>
                    </a>
                }
            </div>
        }
    </section>
}

@code {
    private List<CustomerQuote> QuoteItems { get; set; } = [];
    private bool Loading { get; set; } = true;
    private bool Syncing { get; set; }
    private string SearchText { get; set; } = string.Empty;
    private string StatusFilter { get; set; } = string.Empty;
    private string? SyncMessage { get; set; }

    private List<CustomerQuote> VisibleQuotes =>
        QuoteItems.Where(quote =>
                (string.IsNullOrWhiteSpace(StatusFilter) ||
                 quote.Status.ToString() == StatusFilter) &&
                (string.IsNullOrWhiteSpace(SearchText) ||
                 quote.QuoteNumber.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                 quote.CustomerName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                 (quote.CompanyName?.Contains(
                     SearchText,
                     StringComparison.OrdinalIgnoreCase) ?? false)))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await ShopifySyncService.SynchronizeIfStaleAsync(
                authenticationState.User);
            var result =
                await DispatchQuoteDataSyncService.SynchronizeIfStaleAsync();
            if (result is not null)
            {
                SyncMessage = BuildSyncMessage(result);
            }
        }
        catch (Exception exception)
        {
            SyncMessage = $"Dispatch sync unavailable: {exception.Message}";
        }

        await LoadQuotesAsync();
        Loading = false;
    }

    private async Task RefreshAllAsync()
    {
        Syncing = true;
        SyncMessage = "Refreshing Shopify metafields and Supabase quote data…";
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var shopify = await ShopifySyncService.SynchronizeAsync(
                authenticationState.User);
            var dispatch = await DispatchQuoteDataSyncService
                .SynchronizeAsync();
            SyncMessage =
                $"{BuildSyncMessage(dispatch)} · " +
                $"{shopify.Total} Shopify products";
            await LoadQuotesAsync();
        }
        catch (Exception exception)
        {
            SyncMessage = $"Quote data refresh failed: {exception.Message}";
        }
        finally
        {
            Syncing = false;
        }
    }

    private async Task LoadQuotesAsync()
    {
        await using var dbContext =
            await DbContextFactory.CreateDbContextAsync();
        QuoteItems = await dbContext.CustomerQuotes
            .AsNoTracking()
            .Include(quote => quote.Lines)
            .OrderByDescending(quote => quote.UpdatedAtUtc)
            .ToListAsync();
    }

    private static string BuildSyncMessage(
        DispatchQuoteDataSyncResult result) =>
        $"Dispatch v2: {result.ExistingQuotes + result.ImportedQuotes} quotes · " +
        $"{result.Companies} companies · {result.Products} product prices · " +
        $"{result.MaterialRules} delivery rules · {result.OriginAddresses} origins";

    private static string GetStatusLabel(QuoteStatus status) =>
        status switch
        {
            QuoteStatus.ReadyForReview => "Ready for review",
            _ => status.ToString()
        };

    private static string GetStatusClass(QuoteStatus status) =>
        $"quote-{status.ToString().ToLowerInvariant()}";
}
