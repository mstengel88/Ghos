@page "/"
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Dashboard | GHOS</PageTitle>

<div class="welcome">
    <div>
        <span class="eyebrow">@DateTimeOffset.Now.ToString("dddd, MMMM d").ToUpperInvariant()</span>
        <h2>@Greeting, @DisplayName.</h2>
        <p>Your secure Green Hills workspace is ready for the next foundation module.</p>
    </div>

    <a class="primary-action" href="/products">Open product foundation</a>
</div>

<div class="metric-grid">
    <article class="metric-card">
        <div class="metric-heading">
            <span>Team accounts</span>
            <span class="metric-icon">●</span>
        </div>
        <strong>@UserCount</strong>
        <small>Stored in PostgreSQL Identity</small>
    </article>

    <article class="metric-card">
        <div class="metric-heading">
            <span>Access control</span>
            <span class="metric-icon">✓</span>
        </div>
        <strong>Active</strong>
        <small>Authenticated routes and role policies</small>
    </article>

    <article class="metric-card">
        <div class="metric-heading">
            <span>Database</span>
            <span class="metric-icon">◆</span>
        </div>
        <strong>@DatabaseStatus</strong>
        <small>Identity schema and migrations</small>
    </article>

    <article class="metric-card">
        <div class="metric-heading">
            <span>Foundation</span>
            <span class="metric-icon">2</span>
        </div>
        <strong>2 of 4</strong>
        <small>Infrastructure and identity complete</small>
    </article>
</div>

<div class="dashboard-grid">
    <section class="panel activity-panel">
        <div class="panel-header">
            <div>
                <span class="panel-label">FOUNDATION UPDATE</span>
                <h3>Secure access is operational</h3>
            </div>
        </div>

        <div class="empty-state">
            <div class="empty-icon">✓</div>
            <h4>Identity is connected</h4>
            <p>GHOS now uses PostgreSQL-backed accounts, protected routes, role policies, and secure sign-in cookies. Future modules can build on the same access model.</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <span class="panel-label">ACCESS FOUNDATION</span>
                <h3>Security status</h3>
            </div>
        </div>

        <div class="status-list">
            <div class="status-row">
                <span><i></i> PostgreSQL Identity</span>
                <strong>@DatabaseStatus</strong>
            </div>
            <div class="status-row">
                <span><i></i> Cookie authentication</span>
                <strong>Enabled</strong>
            </div>
            <div class="status-row">
                <span><i></i> Role authorization</span>
                <strong>Enabled</strong>
            </div>
            <div class="status-row">
                <span><i></i> Initial setup</span>
                <strong>Complete</strong>
            </div>
        </div>
    </section>

    <section class="panel large-panel">
        <div class="panel-header">
            <div>
                <span class="panel-label">PRIORITIES</span>
                <h3>Foundation roadmap</h3>
            </div>
        </div>

        <div class="roadmap">
            <div class="roadmap-item complete">
                <span>1</span>
                <div>
                    <strong>Infrastructure foundation</strong>
                    <p>Hyper-V, Ubuntu, Docker and private network</p>
                </div>
            </div>

            <div class="roadmap-item complete">
                <span>2</span>
                <div>
                    <strong>Identity and access</strong>
                    <p>Accounts, roles, authentication and protected modules</p>
                </div>
            </div>

            <div class="roadmap-item current">
                <span>3</span>
                <div>
                    <strong>Product Information Management</strong>
                    <p>Products, categories, synonyms, pricing and Shopify data</p>
                </div>
            </div>

            <div class="roadmap-item">
                <span>4</span>
                <div>
                    <strong>Digital Asset Manager</strong>
                    <p>Photos, videos, documents, tags and product relationships</p>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private int UserCount { get; set; }
    private string DatabaseStatus { get; set; } = "Checking";
    private string DisplayName { get; set; } = "team member";

    private string Greeting => DateTimeOffset.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authenticationState = await AuthenticationStateTask;
            DisplayName = authenticationState.User.FindFirst("display_name")?.Value
                ?? authenticationState.User.Identity?.Name
                ?? "team member";
        }

        try
        {
            UserCount = await DbContext.Users.CountAsync();
            DatabaseStatus = "Connected";
        }
        catch
        {
            DatabaseStatus = "Unavailable";
        }
    }
}
