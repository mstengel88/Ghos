@page "/"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>Dashboard | GHOS</PageTitle>

<div class="welcome">
    <div>
        <span class="eyebrow">@DateTimeOffset.Now.ToString("dddd, MMMM d").ToUpperInvariant()</span>
        <h2>@Greeting, @DisplayName.</h2>
        <p>Your secure Green Hills workspace now includes the first operational product catalog.</p>
    </div>

    <a class="primary-action" href="/products">Open product catalog</a>
</div>

<div class="metric-grid">
    <article class="metric-card">
        <div class="metric-heading">
            <span>Product records</span>
            <span class="metric-icon">◆</span>
        </div>
        <strong>@ProductCount</strong>
        <small>@CategoryCount approved categories</small>
    </article>

    <article class="metric-card">
        <div class="metric-heading">
            <span>Access control</span>
            <span class="metric-icon">✓</span>
        </div>
        <strong>Active</strong>
        <small>Authenticated routes and role policies</small>
    </article>

    <article class="metric-card">
        <div class="metric-heading">
            <span>Database</span>
            <span class="metric-icon">◆</span>
        </div>
        <strong>@DatabaseStatus</strong>
        <small>Identity schema and migrations</small>
    </article>

    <article class="metric-card">
        <div class="metric-heading">
            <span>Team accounts</span>
            <span class="metric-icon">●</span>
        </div>
        <strong>@UserCount</strong>
        <small>Protected by PostgreSQL Identity</small>
    </article>
</div>

<div class="dashboard-grid">
    <section class="panel activity-panel">
        <div class="panel-header">
            <div>
                <span class="panel-label">PRODUCT FOUNDATION</span>
                <h3>The catalog source of truth is ready</h3>
            </div>
        </div>

        <div class="empty-state">
            <div class="empty-icon">✓</div>
            <h4>Product information is connected</h4>
            <p>GHOS can now store official product names, categories, alternate search terms, availability, descriptions, and completeness in PostgreSQL.</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <span class="panel-label">CATALOG STATUS</span>
                <h3>Product system</h3>
            </div>
        </div>

        <div class="status-list">
            <div class="status-row">
                <span><i></i> PostgreSQL catalog</span>
                <strong>@DatabaseStatus</strong>
            </div>
            <div class="status-row">
                <span><i></i> Approved categories</span>
                <strong>@CategoryCount</strong>
            </div>
            <div class="status-row">
                <span><i></i> Search synonyms</span>
                <strong>Enabled</strong>
            </div>
            <div class="status-row">
                <span><i></i> Role-protected editing</span>
                <strong>Enabled</strong>
            </div>
        </div>
    </section>

    <section class="panel large-panel">
        <div class="panel-header">
            <div>
                <span class="panel-label">PRIORITIES</span>
                <h3>Foundation roadmap</h3>
            </div>
        </div>

        <div class="roadmap">
            <div class="roadmap-item complete">
                <span>1</span>
                <div>
                    <strong>Infrastructure foundation</strong>
                    <p>Hyper-V, Ubuntu, Docker and private network</p>
                </div>
            </div>

            <div class="roadmap-item complete">
                <span>2</span>
                <div>
                    <strong>Identity and access</strong>
                    <p>Accounts, roles, authentication and protected modules</p>
                </div>
            </div>

            <div class="roadmap-item complete">
                <span>3</span>
                <div>
                    <strong>Product Information Management</strong>
                    <p>Products, categories, synonyms and reusable customer information</p>
                </div>
            </div>

            <div class="roadmap-item current">
                <span>4</span>
                <div>
                    <strong>Digital Asset Manager</strong>
                    <p>Photos, videos, documents, tags and product relationships</p>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private int UserCount { get; set; }
    private int ProductCount { get; set; }
    private int CategoryCount { get; set; }
    private string DatabaseStatus { get; set; } = "Checking";
    private string DisplayName { get; set; } = "team member";

    private string Greeting => DateTimeOffset.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authenticationState = await AuthenticationStateTask;
            DisplayName = authenticationState.User.FindFirst("display_name")?.Value
                ?? authenticationState.User.Identity?.Name
                ?? "team member";
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            UserCount = await dbContext.Users.CountAsync();
            ProductCount = await dbContext.Products.CountAsync();
            CategoryCount = await dbContext.ProductCategories.CountAsync(category => category.IsActive);
            DatabaseStatus = "Connected";
        }
        catch
        {
            DatabaseStatus = "Unavailable";
        }
    }
}
