@page "/products/new"
@page "/products/{ProductId:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GhosPolicies.Operations)]
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Add product" : "Edit product") | GHOS</PageTitle>

<div class="editor-heading">
    <div>
        <a href="@ReturnUrl">← @(IsReviewMode ? "Review queue" : "Product catalog")</a>
        <span class="panel-label">PRODUCT RECORD</span>
        <h2>@(IsNew ? "Add a product" : $"Edit {Model.Name}")</h2>
        <p>Create one approved source for the product information used by search, marketing, sales sheets, and future website integrations.</p>
    </div>
    @if (!IsNew)
    {
        <div class="editor-score">
            <span>Completeness</span>
            <strong>@CurrentCompleteness%</strong>
        </div>
    }
</div>

@if (Loading)
{
    <section class="panel editor-loading">Loading product information…</section>
}
else if (NotFound)
{
    <section class="panel editor-loading">
        <h3>Product not found</h3>
        <p>The product record may have been removed or the link is no longer valid.</p>
        <a class="primary-action" href="/products">Return to products</a>
    </section>
}
else
{
    <EditForm Model="Model" OnValidSubmit="SaveAsync" class="product-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />

        @if (SourceProduct?.ShopifyProductId is not null &&
            SourceProduct.ReviewedAtUtc is null)
        {
            <div class="review-notice">
                <strong>
                    Shopify import awaiting review
                    @if (IsReviewMode)
                    {
                        <span>· @PendingReviewCount remaining</span>
                    }
                </strong>
                <span>Confirm the category, status, availability, and customer-facing information below. Saving marks this product reviewed.</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(SaveError))
        {
            <div class="auth-alert" role="alert">@SaveError</div>
        }

        <section class="panel form-section">
            <div class="form-section-heading">
                <span>01</span>
                <div>
                    <h3>Identity</h3>
                    <p>The approved product name, internal code, and category.</p>
                </div>
            </div>

            <div class="form-grid">
                <label class="wide">
                    <span>Official product name</span>
                    <InputText @bind-Value="Model.Name" />
                    <ValidationMessage For="() => Model.Name" />
                </label>

                <label>
                    <span>Product code / SKU</span>
                    <InputText @bind-Value="Model.ProductCode" />
                </label>

                <label>
                    <span>Category</span>
                    <InputSelect @bind-Value="Model.ProductCategoryId">
                        <option value="">Select a category</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Model.ProductCategoryId" />
                </label>

                <label>
                    <span>Status</span>
                    <InputSelect @bind-Value="Model.Status">
                        @foreach (var status in Enum.GetValues<ProductStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </label>

                <label class="wide">
                    <span>Alternate names and search synonyms</span>
                    <InputTextArea @bind-Value="Model.AlternateNames" rows="3" />
                    <small>Separate terms with commas or new lines. Example: #57 Stone for the official product #1 Stone.</small>
                </label>
            </div>
        </section>

        <section class="panel form-section">
            <div class="form-section-heading">
                <span>02</span>
                <div>
                    <h3>Customer information</h3>
                    <p>Clear, approved language future channels can reuse.</p>
                </div>
            </div>

            <div class="form-grid">
                <label class="wide">
                    <span>Short description</span>
                    <InputTextArea @bind-Value="Model.ShortDescription" rows="2" />
                    <small>Keep this concise enough for product cards and search results.</small>
                </label>

                <label class="wide">
                    <span>Full description</span>
                    <InputTextArea @bind-Value="Model.Description" rows="5" />
                </label>

                <label>
                    <span>Best uses</span>
                    <InputTextArea @bind-Value="Model.BestUses" rows="5" />
                </label>

                <label>
                    <span>Limitations / not recommended for</span>
                    <InputTextArea @bind-Value="Model.Limitations" rows="5" />
                </label>
            </div>
        </section>

        <section class="panel form-section">
            <div class="form-section-heading">
                <span>03</span>
                <div>
                    <h3>Availability</h3>
                    <p>How Green Hills currently offers this product.</p>
                </div>
            </div>

            <div class="availability-grid">
                <label><InputCheckbox @bind-Value="Model.AvailableForPickup" /> Pickup</label>
                <label><InputCheckbox @bind-Value="Model.AvailableForDelivery" /> Delivery</label>
                <label><InputCheckbox @bind-Value="Model.AvailableInBulk" /> Bulk</label>
                <label><InputCheckbox @bind-Value="Model.AvailableBagged" /> Bagged</label>
            </div>
        </section>

        <div class="form-actions">
            <a href="@ReturnUrl">Cancel</a>
            @if (IsReviewMode)
            {
                <button class="secondary-submit"
                        type="submit"
                        disabled="@Saving"
                        @onclick="() => ContinueReviewAfterSave = false">
                    @(Saving ? "Saving…" : "Save & return to queue")
                </button>
                <button type="submit"
                        disabled="@Saving"
                        @onclick="() => ContinueReviewAfterSave = true">
                    @(Saving ? "Saving…" : "Save & review next")
                </button>
            }
            else
            {
                <button type="submit" disabled="@Saving">
                    @(Saving
                        ? "Saving…"
                        : SourceProduct?.ShopifyProductId is not null &&
                          SourceProduct.ReviewedAtUtc is null
                            ? "Save & mark reviewed"
                            : "Save product")
                </button>
            }
        </div>
    </EditForm>

    @if (!IsNew)
    {
        <section class="panel product-media">
            <div class="product-media-heading">
                <div>
                    <span class="panel-label">PRODUCT MEDIA</span>
                    <h3>Approved product imagery</h3>
                    <p>Review every linked asset and choose one approved image as the primary image used by future product cards and marketing tools.</p>
                </div>
                <div class="media-coverage">
                    <strong>@ProductMedia.Count</strong>
                    <span>linked · @ApprovedImageCount approved</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(MediaMessage))
            {
                <div class="module-notice" role="status">@MediaMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(MediaError))
            {
                <div class="auth-alert" role="alert">@MediaError</div>
            }

            @if (ProductMedia.Count == 0)
            {
                <div class="media-empty">
                    <div class="empty-icon">▣</div>
                    <h4>No media linked yet</h4>
                    <p>Import the Shopify featured image or upload an asset and link it to this product.</p>
                    <div>
                        <AuthorizeView Policy="@GhosPolicies.AdministratorOnly">
                            <a class="secondary-link" href="/assets/shopify">Import Shopify images</a>
                        </AuthorizeView>
                        <a class="primary-action" href="/assets/upload">Upload an asset</a>
                    </div>
                </div>
            }
            else
            {
                <div class="product-media-grid">
                    @foreach (var link in ProductMedia)
                    {
                        var asset = link.DigitalAsset;
                        <article class="product-media-card @(link.IsPrimary ? "primary" : null)">
                            <div class="product-media-preview">
                                @if (CanPreviewImage(asset))
                                {
                                    <img src="/asset-files/@asset.Id"
                                         alt="@asset.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="media-file-kind">@asset.Kind</div>
                                }
                                @if (link.IsPrimary)
                                {
                                    <span class="primary-image-badge">Primary image</span>
                                }
                            </div>
                            <div class="product-media-details">
                                <strong>@asset.Title</strong>
                                <span>@FormatAssetSource(asset.Source) · @FormatAssetStatus(asset.Status)</span>
                                <div class="product-media-actions">
                                    <a href="/assets/@asset.Id/edit">Review asset</a>
                                    @if (!link.IsPrimary && CanSetPrimary(asset))
                                    {
                                        <button type="button"
                                                disabled="@SettingPrimary"
                                                @onclick="() => SetPrimaryImageAsync(asset.Id)">
                                            @(SettingPrimary ? "Saving…" : "Set as primary")
                                        </button>
                                    }
                                    else if (!link.IsPrimary)
                                    {
                                        <small>Approve this image before selecting it.</small>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }

    @if (SourceProduct?.ShopifyProductId is not null)
    {
        <section class="panel shopify-source">
            <div class="shopify-source-heading">
                <div>
                    <span class="panel-label">SHOPIFY SOURCE</span>
                    <h3>@SourceProduct.ShopifyTitle</h3>
                    <p>Read-only store information from the last successful sync. Editing the approved GHOS fields above does not change Shopify.</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(SourceProduct.ShopifyHandle))
                {
                    <a href="https://greenhillssupply.com/products/@SourceProduct.ShopifyHandle"
                       target="_blank"
                       rel="noopener">View product ↗</a>
                }
            </div>

            <div class="shopify-source-meta">
                <span><strong>Status</strong> @SourceProduct.ShopifyStatus</span>
                <span><strong>Vendor</strong> @(SourceProduct.ShopifyVendor ?? "—")</span>
                <span><strong>Type</strong> @(SourceProduct.ShopifyProductType ?? "—")</span>
                <span><strong>Last synced</strong> @FormatTimestamp(SourceProduct.ShopifyLastSyncedAtUtc)</span>
            </div>

            @if (SourceProduct.Variants.Count > 0)
            {
                <div class="variant-table-wrap">
                    <table class="variant-table">
                        <thead>
                            <tr>
                                <th>Variant</th>
                                <th>SKU</th>
                                <th>Price</th>
                                <th>Available online</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in SourceProduct.Variants.OrderBy(item => item.SortOrder))
                            {
                                <tr>
                                    <td>@variant.Title</td>
                                    <td>@(variant.Sku ?? "—")</td>
                                    <td>@variant.Price.ToString("C")</td>
                                    <td>@(variant.AvailableForSale ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    [Parameter]
    public Guid? ProductId { get; set; }

    [SupplyParameterFromQuery(Name = "review")]
    public string? ReviewValue { get; set; }

    private ProductFormModel Model { get; set; } = new();
    private List<ProductCategory> Categories { get; set; } = [];
    private bool Loading { get; set; } = true;
    private bool Saving { get; set; }
    private bool NotFound { get; set; }
    private string? SaveError { get; set; }
    private int CurrentCompleteness { get; set; }
    private int PendingReviewCount { get; set; }
    private Product? SourceProduct { get; set; }
    private List<AssetProductLink> ProductMedia { get; set; } = [];
    private bool SettingPrimary { get; set; }
    private string? MediaMessage { get; set; }
    private string? MediaError { get; set; }
    private int ApprovedImageCount => ProductMedia.Count(link =>
        CanSetPrimary(link.DigitalAsset));
    private bool IsNew => ProductId is null;
    private bool IsReviewMode =>
        !IsNew &&
        ReviewValue == "1" &&
        SourceProduct?.ShopifyProductId is not null;
    private bool ContinueReviewAfterSave { get; set; } = true;
    private string ReturnUrl => IsReviewMode
        ? "/products?review=needed"
        : "/products";

    protected override async Task OnInitializedAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        Categories = await dbContext.ProductCategories
            .AsNoTracking()
            .Where(category => category.IsActive)
            .OrderBy(category => category.SortOrder)
            .ThenBy(category => category.Name)
            .ToListAsync();

        if (ProductId is not null)
        {
            var product = await dbContext.Products
                .AsNoTracking()
                .Include(item => item.AlternateNames)
                .Include(item => item.Variants)
                .Include(item => item.AssetLinks)
                    .ThenInclude(link => link.DigitalAsset)
                .AsSplitQuery()
                .SingleOrDefaultAsync(item => item.Id == ProductId);

            if (product is null)
            {
                NotFound = true;
                Loading = false;
                return;
            }

            Model = new ProductFormModel
            {
                Name = product.Name,
                ProductCode = product.ProductCode,
                ProductCategoryId = product.ProductCategoryId,
                Status = product.Status,
                ShortDescription = product.ShortDescription,
                Description = product.Description,
                BestUses = product.BestUses,
                Limitations = product.Limitations,
                AlternateNames = string.Join(Environment.NewLine, product.AlternateNames.Select(name => name.Name)),
                AvailableForPickup = product.AvailableForPickup,
                AvailableForDelivery = product.AvailableForDelivery,
                AvailableInBulk = product.AvailableInBulk,
                AvailableBagged = product.AvailableBagged
            };

            SourceProduct = product;
            ProductMedia = OrderProductMedia(product.AssetLinks);
            CurrentCompleteness = ProductCompleteness.Calculate(product);

            if (ReviewValue == "1" &&
                product.ShopifyProductId is not null)
            {
                PendingReviewCount = await dbContext.Products
                    .AsNoTracking()
                    .CountAsync(item =>
                        item.ShopifyProductId != null &&
                        item.ReviewedAtUtc == null);
            }
        }

        Loading = false;
    }

    private async Task SetPrimaryImageAsync(Guid assetId)
    {
        if (ProductId is null)
        {
            return;
        }

        SettingPrimary = true;
        MediaMessage = null;
        MediaError = null;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var selectedLink = await dbContext.AssetProductLinks
                .Include(link => link.DigitalAsset)
                .SingleOrDefaultAsync(link =>
                    link.ProductId == ProductId.Value &&
                    link.DigitalAssetId == assetId);

            if (selectedLink is null)
            {
                MediaError = "That image is no longer linked to this product.";
                return;
            }

            if (!CanSetPrimary(selectedLink.DigitalAsset))
            {
                MediaError = "Only an approved image can be selected as the primary product image.";
                return;
            }

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirstValue(
                ClaimTypes.NameIdentifier);
            var now = DateTime.UtcNow;

            await using var transaction = await dbContext.Database.BeginTransactionAsync();
            await dbContext.AssetProductLinks
                .Where(link =>
                    link.ProductId == ProductId.Value &&
                    link.IsPrimary)
                .ExecuteUpdateAsync(updates => updates
                    .SetProperty(link => link.IsPrimary, false)
                    .SetProperty(link => link.PrimaryAssignedAtUtc, (DateTime?)null)
                    .SetProperty(link => link.PrimaryAssignedByUserId, (string?)null));

            selectedLink.IsPrimary = true;
            selectedLink.PrimaryAssignedAtUtc = now;
            selectedLink.PrimaryAssignedByUserId = userId;
            await dbContext.SaveChangesAsync();
            await transaction.CommitAsync();

            ProductMedia = await dbContext.AssetProductLinks
                .AsNoTracking()
                .Where(link => link.ProductId == ProductId.Value)
                .Include(link => link.DigitalAsset)
                .ToListAsync();
            ProductMedia = OrderProductMedia(ProductMedia);
            MediaMessage = $"{selectedLink.DigitalAsset.Title} is now the primary product image.";
        }
        catch (DbUpdateException)
        {
            MediaError = "The primary image could not be updated. Refresh the page and try again.";
        }
        finally
        {
            SettingPrimary = false;
        }
    }

    private async Task SaveAsync()
    {
        Saving = true;
        SaveError = null;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            Product product;

            if (ProductId is null)
            {
                product = new Product();
                dbContext.Products.Add(product);
            }
            else
            {
                product = await dbContext.Products
                    .Include(item => item.AlternateNames)
                    .SingleAsync(item => item.Id == ProductId);
            }

            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            var now = DateTime.UtcNow;

            product.Name = Model.Name.Trim();
            product.Slug = await CreateUniqueSlugAsync(dbContext, product.Name, product.Id);
            product.ProductCode = NullIfWhiteSpace(Model.ProductCode);
            product.ProductCategoryId = Model.ProductCategoryId!.Value;
            product.Status = Model.Status;
            product.ShortDescription = NullIfWhiteSpace(Model.ShortDescription);
            product.Description = NullIfWhiteSpace(Model.Description);
            product.BestUses = NullIfWhiteSpace(Model.BestUses);
            product.Limitations = NullIfWhiteSpace(Model.Limitations);
            product.AvailableForPickup = Model.AvailableForPickup;
            product.AvailableForDelivery = Model.AvailableForDelivery;
            product.AvailableInBulk = Model.AvailableInBulk;
            product.AvailableBagged = Model.AvailableBagged;
            product.ReviewedAtUtc = now;
            product.ReviewedByUserId = userId;
            product.UpdatedAtUtc = now;
            product.UpdatedByUserId = userId;

            if (ProductId is null)
            {
                product.CreatedAtUtc = now;
                product.CreatedByUserId = userId;
            }

            var alternateNames = ParseAlternateNames(
                    Model.AlternateNames,
                    product.Name)
                .ToList();
            await ValidateAlternateNamesAsync(
                dbContext,
                product.Id,
                product.Name,
                alternateNames);
            ReconcileAlternateNames(
                dbContext,
                product,
                alternateNames);

            await dbContext.SaveChangesAsync();

            if (IsReviewMode && ContinueReviewAfterSave)
            {
                var nextProductId = await dbContext.Products
                    .AsNoTracking()
                    .Where(item =>
                        item.Id != product.Id &&
                        item.ShopifyProductId != null &&
                        item.ReviewedAtUtc == null)
                    .OrderBy(item => item.Name)
                    .Select(item => (Guid?)item.Id)
                    .FirstOrDefaultAsync();

                Navigation.NavigateTo(
                    nextProductId is null
                        ? "/products?review=needed&reviewComplete=1"
                        : $"/products/{nextProductId}/edit?review=1",
                    forceLoad: true);
                return;
            }

            Navigation.NavigateTo(
                IsReviewMode
                    ? "/products?review=needed&saved=1"
                    : "/products?saved=1",
                forceLoad: true);
        }
        catch (DuplicateProductNameException exception)
        {
            SaveError = exception.Message;
        }
        catch (DbUpdateException exception)
        {
            SaveError = IsUniqueConstraintViolation(exception)
                ? "This product conflicts with an existing product name, code, or alternate name. Review the values and try again."
                : "The product could not be saved because of a database error. No changes were applied; try again or review the server log.";
        }
        catch (InvalidOperationException)
        {
            SaveError = "The product could not be found or was updated elsewhere. Return to the catalog and try again.";
        }
        finally
        {
            Saving = false;
        }
    }

    private static async Task<string> CreateUniqueSlugAsync(
        ApplicationDbContext dbContext,
        string name,
        Guid currentProductId)
    {
        var baseSlug = ProductSlug.Create(name);
        var candidate = baseSlug;
        var suffix = 2;

        while (await dbContext.Products.AnyAsync(product =>
            product.Id != currentProductId && product.Slug == candidate))
        {
            candidate = $"{baseSlug}-{suffix++}";
        }

        return candidate;
    }

    private static IEnumerable<string> ParseAlternateNames(string? value, string officialName) =>
        (value ?? string.Empty)
            .Split([',', ';', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(name => !name.Equals(officialName, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private static async Task ValidateAlternateNamesAsync(
        ApplicationDbContext dbContext,
        Guid productId,
        string officialName,
        IReadOnlyCollection<string> alternateNames)
    {
        var normalizedOfficialName = NormalizeProductName(officialName);
        var normalizedAlternateNames = alternateNames
            .Select(NormalizeProductName)
            .ToHashSet(StringComparer.Ordinal);

        var conflictingOfficialName = await dbContext.Products
            .AsNoTracking()
            .Where(item => item.Id != productId)
            .Select(item => item.Name)
            .FirstOrDefaultAsync(name =>
                name.ToUpper() == normalizedOfficialName ||
                normalizedAlternateNames.Contains(name.ToUpper()));
        if (conflictingOfficialName is not null)
        {
            throw new DuplicateProductNameException(
                $"“{conflictingOfficialName}” is already an official product name.");
        }

        var conflictingAlternateName = await dbContext.ProductAlternateNames
            .AsNoTracking()
            .Where(item =>
                item.ProductId != productId &&
                (item.NormalizedName == normalizedOfficialName ||
                 normalizedAlternateNames.Contains(item.NormalizedName)))
            .Select(item => item.Name)
            .FirstOrDefaultAsync();
        if (conflictingAlternateName is not null)
        {
            throw new DuplicateProductNameException(
                $"“{conflictingAlternateName}” is already assigned to another product.");
        }
    }

    private static void ReconcileAlternateNames(
        ApplicationDbContext dbContext,
        Product product,
        IReadOnlyCollection<string> desiredNames)
    {
        var desiredByNormalizedName = desiredNames.ToDictionary(
            NormalizeProductName,
            StringComparer.Ordinal);
        var removedNames = product.AlternateNames
            .Where(existing =>
                !desiredByNormalizedName.ContainsKey(existing.NormalizedName))
            .ToList();

        foreach (var removedName in removedNames)
        {
            product.AlternateNames.Remove(removedName);
        }

        foreach (var existingName in product.AlternateNames)
        {
            existingName.Name =
                desiredByNormalizedName[existingName.NormalizedName];
        }

        var existingNormalizedNames = product.AlternateNames
            .Select(item => item.NormalizedName)
            .ToHashSet(StringComparer.Ordinal);
        foreach (var (normalizedName, alternateName) in desiredByNormalizedName)
        {
            if (existingNormalizedNames.Contains(normalizedName))
            {
                continue;
            }

            var newAlternateName = new ProductAlternateName
            {
                Name = alternateName,
                NormalizedName = normalizedName
            };
            product.AlternateNames.Add(newAlternateName);
            dbContext.ProductAlternateNames.Add(newAlternateName);
        }
    }

    private static bool IsUniqueConstraintViolation(
        DbUpdateException exception) =>
        exception.InnerException is Npgsql.PostgresException
        {
            SqlState: Npgsql.PostgresErrorCodes.UniqueViolation
        };

    private static string NormalizeProductName(string name) =>
        name.Trim().ToUpperInvariant();

    private sealed class DuplicateProductNameException(string message)
        : Exception(message);

    private static string? NullIfWhiteSpace(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatTimestamp(DateTime? timestamp) =>
        timestamp is null
            ? "Not recorded"
            : timestamp.Value.ToLocalTime().ToString("MMM d, yyyy · h:mm tt");

    private static List<AssetProductLink> OrderProductMedia(
        IEnumerable<AssetProductLink> links) =>
        links
            .OrderByDescending(link => link.IsPrimary)
            .ThenBy(link => link.SortOrder)
            .ThenByDescending(link => link.DigitalAsset.CreatedAtUtc)
            .ToList();

    private static bool CanPreviewImage(DigitalAsset asset) =>
        asset.Kind == AssetKind.Image &&
        asset.ContentType is "image/jpeg" or "image/png" or "image/webp" or "image/gif";

    private static bool CanSetPrimary(DigitalAsset asset) =>
        asset.Kind == AssetKind.Image &&
        asset.Status == AssetStatus.Approved;

    private static string FormatAssetSource(AssetSource source) => source switch
    {
        AssetSource.Shopify => "Shopify",
        AssetSource.Upload => "Uploaded",
        AssetSource.ICloudImport => "iCloud import",
        _ => source.ToString()
    };

    private static string FormatAssetStatus(AssetStatus status) => status switch
    {
        AssetStatus.PendingReview => "Pending review",
        AssetStatus.Approved => "Approved",
        AssetStatus.Archived => "Archived",
        _ => status.ToString()
    };
}
