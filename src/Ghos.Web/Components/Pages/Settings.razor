@page "/settings"
@attribute [Authorize(Policy = GhosPolicies.AdministratorOnly)]

<PageTitle>Settings | GHOS</PageTitle>

<div class="settings-heading">
    <span class="panel-label">ADMINISTRATION</span>
    <h2>Settings</h2>
    <p>Manage protected connections and system-level GHOS configuration.</p>
</div>

<div class="settings-grid">
    <a class="panel settings-card" href="/products/shopify">
        <span class="settings-icon">S</span>
        <div>
            <span class="panel-label">CATALOG</span>
            <h3>Shopify connection</h3>
            <p>Manage encrypted store credentials and product synchronization.</p>
        </div>
        <strong>Open →</strong>
    </a>

    <a class="panel settings-card" href="/settings/dispatch">
        <span class="settings-icon">D</span>
        <div>
            <span class="panel-label">OPERATIONS</span>
            <h3>Dispatch connection</h3>
            <p>Connect the signed read-only order and delivery feed.</p>
        </div>
        <strong>Open →</strong>
    </a>
</div>
