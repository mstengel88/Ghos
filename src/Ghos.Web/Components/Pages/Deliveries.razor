@page "/deliveries"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GhosPolicies.Operations)]
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject DispatchSyncService DispatchSyncService

<PageTitle>Deliveries | GHOS</PageTitle>

<div class="delivery-heading">
    <div>
        <span class="panel-label">DELIVERY OPERATIONS</span>
        <h2>@(DisplayMode == "Calendar"
            ? "Delivery Calendar"
            : "Delivery Board")</h2>
        <p>A read-only GHOS mirror of dispatch assignments, route progress, and proof-of-delivery status.</p>
    </div>
    <div class="heading-actions">
        <DispatchRefreshControl OnSynchronized="LoadAsync" />
        <a href="/settings/dispatch">Dispatch sync</a>
        <a href="/orders">Open Orders →</a>
    </div>
</div>

@if (Loading)
{
    <section class="panel delivery-empty">Preparing deliveries…</section>
}
else
{
    var visibleDeliveries = GetVisibleDeliveries();
    var currentDeliveries = DeliveryItems
        .Where(DispatchOperationalTime.IsCurrentWork)
        .ToList();
    var noDateItems = visibleDeliveries
        .Where(item => item.ScheduledForUtc is null)
        .ToList();
    var closedDayItems = visibleDeliveries
        .Where(item =>
            item.ScheduledForUtc is not null &&
            item.ScheduledForUtc.Value.DayOfWeek ==
                DayOfWeek.Sunday)
        .ToList();
    <section class="delivery-summary">
        <article>
            <span>Unscheduled</span>
            <strong>@currentDeliveries.Count(item =>
                item.Status == DeliveryStatus.Unscheduled)</strong>
            <small>Current work waiting for a route</small>
        </article>
        <article>
            <span>Scheduled</span>
            <strong>@currentDeliveries.Count(item =>
                item.Status == DeliveryStatus.Scheduled)</strong>
            <small>Assigned and not started</small>
        </article>
        <article>
            <span>On the road</span>
            <strong>@currentDeliveries.Count(item =>
                item.Status is DeliveryStatus.EnRoute or
                    DeliveryStatus.Arrived)</strong>
            <small>En route or at the jobsite</small>
        </article>
        <article>
            <span>Issues</span>
            <strong>@currentDeliveries.Count(item =>
                item.Status == DeliveryStatus.Issue)</strong>
            <small>Needs dispatcher attention</small>
        </article>
    </section>

    <div class="delivery-layout">
        <section class="panel delivery-board">
            <div class="board-toolbar">
                <label>
                    <span>Search deliveries</span>
                    <input @bind="SearchText"
                           @bind:event="oninput"
                           placeholder="Order, customer, route, or material…" />
                </label>
                <label>
                    <span>Delivery status</span>
                    <select @bind="StatusFilter">
                        <option value="Current">Current work</option>
                        <option value="All">All history</option>
                        @foreach (var status in Enum.GetValues<DeliveryStatus>())
                        {
                            <option value="@status.ToString()">@GetStatusLabel(status)</option>
                        }
                    </select>
                </label>
                <div class="delivery-view-switch">
                    <span>View</span>
                    <div>
                        <button type="button"
                                class="@(DisplayMode == "Board" ? "active" : null)"
                                @onclick="ShowBoard">
                            Board
                        </button>
                        <button type="button"
                                class="@(DisplayMode == "Calendar" ? "active" : null)"
                                @onclick="ShowCalendar">
                            Calendar
                        </button>
                    </div>
                </div>
            </div>

            @if (DeliveryItems.Count == 0)
            {
                <div class="delivery-empty integration-empty">
                    <div class="empty-icon">▰</div>
                    <h3>Dispatch feed not connected yet</h3>
                    <p>Once the signed read-only endpoint is enabled, GHOS will mirror delivery tickets here while the dispatch app remains responsible for routes, drivers, and delivery proof.</p>
                    <div class="integration-flow">
                        <span>Dispatch app</span>
                        <i>signed feed →</i>
                        <span>GHOS mirror</span>
                    </div>
                </div>
            }
            else if (visibleDeliveries.Count == 0)
            {
                <div class="delivery-empty">No delivery tickets match these filters.</div>
            }
            else
            {
                @if (DisplayMode == "Calendar")
                {
                    <div class="calendar-navigation">
                        <button type="button" @onclick="PreviousWeek">← Previous</button>
                        <div>
                            <strong>@FormatCalendarRange()</strong>
                            <button type="button" @onclick="GoToCurrentWeek">Today</button>
                        </div>
                        <button type="button" @onclick="NextWeek">Next →</button>
                    </div>

                    <div class="delivery-calendar">
                        @foreach (var day in GetCalendarDays())
                        {
                            var dayItems = GetDeliveriesForDay(
                                visibleDeliveries,
                                day);
                            <section class="calendar-day @(day == DispatchOperationalTime.Today ? "today" : null)">
                                <header>
                                    <span>@day.ToString("ddd")</span>
                                    <strong>@day.Day</strong>
                                    <small>@day.ToString("MMM")</small>
                                </header>
                                <div>
                                    @if (dayItems.Count == 0)
                                    {
                                        <p>No deliveries</p>
                                    }
                                    else
                                    {
                                        @foreach (var delivery in dayItems)
                                        {
                                            <button type="button"
                                                    class="calendar-order @(SelectedDeliveryId == delivery.Id ? "selected" : null)"
                                                    @onclick="() => SelectDelivery(delivery.Id)">
                                                <span>
                                                    #@delivery.SalesOrder.OrderNumber
                                                    <i class="@GetStatusClass(delivery.Status)">
                                                        @GetStatusLabel(delivery.Status)
                                                    </i>
                                                </span>
                                                <strong>@delivery.SalesOrder.CustomerName</strong>
                                                <small>@delivery.Material · @delivery.Quantity @delivery.Unit</small>
                                                <small>@GetRouteLabel(delivery)</small>
                                                <div class="calendar-order-timing">
                                                    <span>
                                                        Window:
                                                        @GetDispatchWindowTime(
                                                            delivery)
                                                    </span>
                                                    <span>
                                                        @GetRoundTripTime(
                                                            delivery,
                                                            compact: true)
                                                    </span>
                                                </div>
                                            </button>
                                        }
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    @if (noDateItems.Count > 0)
                    {
                        <section class="calendar-no-date">
                            <div>
                                <span>DATE REQUIRED</span>
                                <strong>Unscheduled date queue</strong>
                                <small>@noDateItems.Count order(s)</small>
                            </div>
                            <div>
                                @foreach (var delivery in noDateItems)
                                {
                                    <button type="button"
                                            @onclick="() => SelectDelivery(delivery.Id)">
                                        <strong>#@delivery.SalesOrder.OrderNumber</strong>
                                        <span>@delivery.SalesOrder.CustomerName</span>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                    @if (closedDayItems.Count > 0)
                    {
                        <section class="calendar-no-date closed-day-review">
                            <div>
                                <span>CLOSED DAY</span>
                                <strong>Sunday date review</strong>
                                <small>@closedDayItems.Count order(s)</small>
                            </div>
                            <div>
                                @foreach (var delivery in closedDayItems)
                                {
                                    <button type="button"
                                            @onclick="() => SelectDelivery(delivery.Id)">
                                        <strong>#@delivery.SalesOrder.OrderNumber</strong>
                                        <span>
                                            @delivery.SalesOrder.CustomerName ·
                                            @FormatDeliveryDate(
                                                delivery.ScheduledForUtc)
                                        </span>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                }
                else
                {
                    <div class="delivery-columns">
                        @foreach (var lane in ActiveLanes)
                        {
                            var laneItems = visibleDeliveries
                                .Where(item => LaneContains(lane.Statuses, item.Status))
                                .OrderBy(item => item.StopSequence ?? int.MaxValue)
                                .ThenBy(item => item.ScheduledForUtc)
                                .ToList();
                            <section class="delivery-lane">
                                <div class="lane-heading">
                                    <span class="@lane.CssClass"></span>
                                    <strong>@lane.Label</strong>
                                    <small>@laneItems.Count</small>
                                </div>
                                @if (laneItems.Count == 0)
                                {
                                    <p>No tickets</p>
                                }
                                else
                                {
                                    @foreach (var delivery in laneItems)
                                    {
                                        <button type="button"
                                                class="delivery-card @(SelectedDeliveryId == delivery.Id ? "selected" : null)"
                                                @onclick="() => SelectDelivery(delivery.Id)">
                                            <div>
                                                <span>#@delivery.SalesOrder.OrderNumber</span>
                                                <span>@GetRouteLabel(delivery)</span>
                                            </div>
                                            <span class="delivery-card-date">
                                                <i>▦</i>
                                                @FormatDeliveryDate(
                                                    delivery.ScheduledForUtc)
                                            </span>
                                            <strong>@delivery.SalesOrder.CustomerName</strong>
                                            <p>@delivery.Material · @delivery.Quantity @delivery.Unit</p>
                                            <small>@GetLocation(delivery.SalesOrder)</small>
                                        </button>
                                    }
                                }
                            </section>
                        }
                    </div>
                }
            }
        </section>

        <aside class="panel delivery-detail">
            @if (SelectedDelivery is null)
            {
                <div class="detail-empty">
                    <div class="empty-icon">▰</div>
                    <h3>Select a delivery</h3>
                    <p>Review the linked order, material, route, driver, ETA, and proof status.</p>
                </div>
            }
            else
            {
                <span class="status-pill @GetStatusClass(SelectedDelivery.Status)">
                    @GetStatusLabel(SelectedDelivery.Status)
                </span>
                <h3>@SelectedDelivery.Material</h3>
                <p class="detail-subtitle">
                    Order #@SelectedDelivery.SalesOrder.OrderNumber ·
                    @SelectedDelivery.Quantity @SelectedDelivery.Unit
                </p>

                <dl>
                    <div>
                        <dt>Customer</dt>
                        <dd>@SelectedDelivery.SalesOrder.CustomerName</dd>
                    </div>
                    <div>
                        <dt>Address</dt>
                        <dd>@GetFullAddress(SelectedDelivery.SalesOrder)</dd>
                    </div>
                    <div>
                        <dt>Delivery date</dt>
                        <dd>@FormatDeliveryDate(
                            SelectedDelivery.ScheduledForUtc)</dd>
                    </div>
                    <div>
                        <dt>Dispatch window time</dt>
                        <dd>@GetDispatchWindowTime(
                            SelectedDelivery)</dd>
                    </div>
                    <div>
                        <dt>Customer time preference</dt>
                        <dd>@GetTimePreference(SelectedDelivery)</dd>
                    </div>
                    <div>
                        <dt>Route / stop</dt>
                        <dd>@GetRouteDetail(SelectedDelivery)</dd>
                    </div>
                    <div>
                        <dt>Truck / driver</dt>
                        <dd>@GetTruckDriver(SelectedDelivery)</dd>
                    </div>
                    <div>
                        <dt>ETA</dt>
                        <dd>@(SelectedDelivery.Eta ?? "Not available")</dd>
                    </div>
                    <div>
                        <dt>Round trip time</dt>
                        <dd>@GetRoundTripTime(SelectedDelivery)</dd>
                    </div>
                    <div>
                        <dt>Travel distance</dt>
                        <dd>@GetTravelDistance(SelectedDelivery)</dd>
                    </div>
                </dl>

                <div class="proof-panel">
                    <span>Delivery proof</span>
                    <strong>@GetProofSummary(SelectedDelivery)</strong>
                    @if (!string.IsNullOrWhiteSpace(SelectedDelivery.ProofNotes))
                    {
                        <p>@SelectedDelivery.ProofNotes</p>
                    }
                </div>

                <div class="detail-links">
                    <a href="/orders">View linked order →</a>
                    @if (GetDispatchUrl(SelectedDelivery) is
                        { } dispatchUrl)
                    {
                        <a href="@dispatchUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            Open in Dispatch ↗
                        </a>
                    }
                </div>
            }
        </aside>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "deliveryId")]
    public Guid? RequestedDeliveryId { get; set; }

    private static readonly DeliveryLane[] ActiveLanes =
    [
        new(
            "Needs route",
            "lane-unscheduled",
            [DeliveryStatus.Unscheduled]),
        new(
            "Scheduled",
            "lane-scheduled",
            [DeliveryStatus.Scheduled]),
        new(
            "On the road",
            "lane-enroute",
            [DeliveryStatus.EnRoute, DeliveryStatus.Arrived]),
        new(
            "Completed / issue",
            "lane-complete",
            [
                DeliveryStatus.Delivered,
                DeliveryStatus.Issue,
                DeliveryStatus.Cancelled
            ])
    ];

    private List<Delivery> DeliveryItems { get; set; } = [];
    private Guid? SelectedDeliveryId { get; set; }
    private Delivery? SelectedDelivery =>
        DeliveryItems.FirstOrDefault(item => item.Id == SelectedDeliveryId);
    private string SearchText { get; set; } = string.Empty;
    private string StatusFilter { get; set; } = "Current";
    private string? DispatchBaseUrl { get; set; }
    private string DisplayMode { get; set; } = "Board";
    private DateOnly CalendarStart { get; set; } =
        GetWeekStart(DispatchOperationalTime.Today);
    private bool Loading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var dbContext =
            await DbContextFactory.CreateDbContextAsync();
        DeliveryItems = await dbContext.Deliveries
            .AsNoTracking()
            .Include(item => item.SalesOrder)
            .OrderBy(item => item.StopSequence)
            .ThenBy(item => item.ScheduledForUtc)
            .ToListAsync();
        var settings =
            await DispatchSyncService.GetSettingsAsync();
        DispatchBaseUrl = settings?.BaseUrl;
        SelectedDeliveryId = DeliveryItems.Any(item =>
                item.Id == RequestedDeliveryId)
            ? RequestedDeliveryId
            : DeliveryItems.Any(item =>
                    item.Id == SelectedDeliveryId)
                ? SelectedDeliveryId
                : DeliveryItems.FirstOrDefault(
                        DispatchOperationalTime.IsCurrentWork)?.Id ??
                    DeliveryItems.FirstOrDefault()?.Id;
        Loading = false;
    }

    private List<Delivery> GetVisibleDeliveries()
    {
        var query = DeliveryItems.AsEnumerable();
        query = StatusFilter switch
        {
            "Current" => query.Where(
                DispatchOperationalTime.IsCurrentWork),
            "All" => query,
            _ when Enum.TryParse<DeliveryStatus>(
                StatusFilter,
                out var status) =>
                query.Where(item => item.Status == status),
            _ => query
        };

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var search = SearchText.Trim();
            query = query.Where(item =>
                item.SalesOrder.OrderNumber.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                item.SalesOrder.CustomerName.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                item.Material.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                (item.RouteCode?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return query.ToList();
    }

    private void SelectDelivery(Guid id) => SelectedDeliveryId = id;

    private void ShowBoard() => DisplayMode = "Board";

    private void ShowCalendar() => DisplayMode = "Calendar";

    private IEnumerable<DateOnly> GetCalendarDays() =>
        Enumerable.Range(0, 6)
            .Select(offset => CalendarStart.AddDays(offset));

    private static List<Delivery> GetDeliveriesForDay(
        IEnumerable<Delivery> deliveries,
        DateOnly day) =>
        deliveries
            .Where(item =>
                item.ScheduledForUtc is not null &&
                DateOnly.FromDateTime(
                    item.ScheduledForUtc.Value) == day)
            .OrderBy(item => item.StopSequence ?? int.MaxValue)
            .ThenBy(item => item.SalesOrder.CustomerName)
            .ToList();

    private void PreviousWeek() =>
        CalendarStart = CalendarStart.AddDays(-7);

    private void NextWeek() =>
        CalendarStart = CalendarStart.AddDays(7);

    private void GoToCurrentWeek() =>
        CalendarStart = GetWeekStart(
            DispatchOperationalTime.Today);

    private string FormatCalendarRange()
    {
        var end = CalendarStart.AddDays(5);
        return CalendarStart.Year == end.Year
            ? $"{CalendarStart:MMM d} – {end:MMM d, yyyy}"
            : $"{CalendarStart:MMM d, yyyy} – {end:MMM d, yyyy}";
    }

    private static DateOnly GetWeekStart(DateOnly date)
    {
        if (date.DayOfWeek == DayOfWeek.Sunday)
        {
            return date.AddDays(1);
        }

        var offset = (int)date.DayOfWeek -
            (int)DayOfWeek.Monday;
        return date.AddDays(-offset);
    }

    private static bool LaneContains(
        IReadOnlyCollection<DeliveryStatus> statuses,
        DeliveryStatus status) =>
        statuses.Contains(status);

    private static string GetStatusLabel(DeliveryStatus status) =>
        status switch
        {
            DeliveryStatus.EnRoute => "En route",
            _ => status.ToString()
        };

    private static string GetStatusClass(DeliveryStatus status) =>
        $"delivery-{status.ToString().ToLowerInvariant()}";

    private static string FormatDeliveryDate(DateTime? scheduledForUtc)
    {
        if (scheduledForUtc is null)
        {
            return "Date not set";
        }

        var date = DateOnly.FromDateTime(scheduledForUtc.Value);
        return date == DispatchOperationalTime.Today
            ? $"Today · {date:ddd, MMM d}"
            : date.ToString("ddd, MMM d, yyyy");
    }

    private static string GetRouteLabel(Delivery delivery) =>
        string.IsNullOrWhiteSpace(delivery.RouteCode)
            ? "No route"
            : delivery.StopSequence is null
                ? delivery.RouteCode
                : $"{delivery.RouteCode} · Stop {delivery.StopSequence}";

    private static string GetRouteDetail(Delivery delivery) =>
        string.IsNullOrWhiteSpace(delivery.RouteCode)
            ? "Not assigned"
            : delivery.StopSequence is null
                ? delivery.RouteCode
                : $"{delivery.RouteCode}, stop {delivery.StopSequence}";

    private static string GetTruckDriver(Delivery delivery)
    {
        var values = new[] { delivery.Truck, delivery.DriverName }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var result = string.Join(" · ", values);
        return string.IsNullOrWhiteSpace(result)
            ? "Not assigned"
            : result;
    }

    private static string GetLocation(SalesOrder order) =>
        string.IsNullOrWhiteSpace(order.DeliveryCity)
            ? order.DeliveryAddress
            : order.DeliveryCity;

    private static string GetFullAddress(SalesOrder order)
    {
        var locality = string.Join(
            " ",
            new[]
            {
                order.DeliveryCity,
                order.DeliveryState,
                order.DeliveryPostalCode
            }.Where(value => !string.IsNullOrWhiteSpace(value)));
        return string.IsNullOrWhiteSpace(locality)
            ? order.DeliveryAddress
            : $"{order.DeliveryAddress}, {locality}";
    }

    private static string GetDispatchWindowTime(Delivery delivery) =>
        string.IsNullOrWhiteSpace(delivery.Eta)
            ? "Not scheduled"
            : delivery.Eta.Trim();

    private static string GetTimePreference(Delivery delivery) =>
        string.IsNullOrWhiteSpace(
            delivery.SalesOrder.TimePreference)
            ? "Not specified"
            : delivery.SalesOrder.TimePreference.Trim();

    private static string GetRoundTripTime(
        Delivery delivery,
        bool compact = false)
    {
        if (delivery.TravelMinutes is null)
        {
            return compact
                ? "RT not calculated"
                : "Not calculated";
        }

        var totalMinutes = Math.Max(
            0,
            (int)Math.Round(
                delivery.TravelMinutes.Value,
                MidpointRounding.AwayFromZero));
        if (totalMinutes < 60)
        {
            return compact
                ? $"RT: {totalMinutes} min"
                : $"{totalMinutes} min";
        }

        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        if (compact)
        {
            return minutes == 0
                ? $"RT: {hours}h"
                : $"RT: {hours}h {minutes}m";
        }

        var hourLabel = hours == 1 ? "hr" : "hrs";
        return minutes == 0
            ? $"{hours} {hourLabel}"
            : $"{hours} {hourLabel} {minutes} min";
    }

    private static string GetTravelDistance(Delivery delivery) =>
        delivery.TravelMiles is null
            ? "Not calculated"
            : $"{delivery.TravelMiles:0.0} mi";

    private static string GetProofSummary(Delivery delivery)
    {
        if (delivery.Status != DeliveryStatus.Delivered)
        {
            return "Pending delivery";
        }
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(delivery.ProofName))
        {
            parts.Add($"Received by {delivery.ProofName}");
        }
        if (delivery.ProofPhotoCount > 0)
        {
            parts.Add($"{delivery.ProofPhotoCount} photo(s)");
        }
        return parts.Count == 0
            ? "Delivered; proof not recorded"
            : string.Join(" · ", parts);
    }

    private string? GetDispatchUrl(Delivery delivery) =>
        DispatchOrderLinks.Build(
            DispatchBaseUrl,
            delivery.ExternalDispatchId);

    private sealed record DeliveryLane(
        string Label,
        string CssClass,
        IReadOnlyCollection<DeliveryStatus> Statuses);
}
