    private async Task CalculateDeliveryAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        if (string.IsNullOrWhiteSpace(Model.AddressLine1) ||
            string.IsNullOrWhiteSpace(Model.City) ||
            string.IsNullOrWhiteSpace(Model.State) ||
            string.IsNullOrWhiteSpace(Model.PostalCode))
        {
            ErrorMessage =
                "Enter the complete delivery address before calculating delivery.";
            return;
        }

        CalculatingDelivery = true;
        try
        {
            var result = await DeliveryService.CalculateAsync(
                new QuoteDeliveryRequest(
                    Model.AddressLine1,
                    Model.AddressLine2,
                    Model.City,
                    Model.State,
                    Model.PostalCode,
                    Model.Country,
                    Model.RatePerMinute,
                    Model.Lines.Select(line => new QuoteDeliveryItem(
                        line.Sku,
                        line.Quantity,
                        line.Vendor)).ToList()));
            Model.CalculatedDeliveryAmount = result.Amount;
            Model.DeliveryServiceName = result.ServiceName;
            Model.DeliveryDescription = result.Description;
            Model.DeliveryEta = result.Eta;
            Model.DeliverySummary = result.Summary;
            Model.SourceBreakdownJson = result.SourceBreakdownJson;
            SuccessMessage = result.IsOutsideDeliveryArea
                ? $"{result.Summary}. This destination is {result.OutsideDeliveryMiles:0.0} miles away."
                : $"{result.ServiceName}: {result.Amount:C2}";
        }
        catch (Exception exception)
        {
            ErrorMessage =
                $"Delivery could not be calculated. {exception.Message}";
        }
        finally
        {
            CalculatingDelivery = false;
        }
    }

    private async Task SaveAndPrintAsync()
    {
        PrintAfterSave = true;
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        Saving = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            if (Model.Audience == QuoteAudience.Contractor &&
                string.IsNullOrWhiteSpace(Model.CompanyName))
            {
                throw new InvalidOperationException(
                    "A company name is required for contractor pricing.");
            }
            if (Model.Lines.Count == 0 ||
                Model.Lines.All(line => line.Quantity <= 0))
            {
                throw new InvalidOperationException(
                    "Add at least one product with a quantity greater than zero.");
            }
            if (string.IsNullOrWhiteSpace(Model.AddressLine1) ||
                string.IsNullOrWhiteSpace(Model.City) ||
                string.IsNullOrWhiteSpace(Model.State) ||
                string.IsNullOrWhiteSpace(Model.PostalCode))
            {
                throw new InvalidOperationException(
                    "A complete delivery address is required.");
            }

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authenticationState.User.FindFirstValue(
                System.Security.Claims.ClaimTypes.NameIdentifier);
            await using var dbContext =
                await DbContextFactory.CreateDbContextAsync();
            CustomerQuote quote;
            if (QuoteId is null)
            {
                quote = new CustomerQuote
                {
                    QuoteNumber =
                        $"GH-{DateTime.Now:yyyy}-{Guid.NewGuid().ToString("N")[..6].ToUpperInvariant()}",
                    CreatedAtUtc = DateTime.UtcNow,
                    CreatedByUserId = userId
                };
                dbContext.CustomerQuotes.Add(quote);
            }
            else
            {
                quote = await dbContext.CustomerQuotes
                    .Include(item => item.Lines)
                    .SingleAsync(item => item.Id == QuoteId);
                dbContext.CustomerQuoteLines.RemoveRange(quote.Lines);
            }

            MapToEntity(quote, userId);
            await dbContext.SaveChangesAsync();
            QuoteId = quote.Id;
            Model.QuoteNumber = quote.QuoteNumber;
            SuccessMessage = $"{quote.QuoteNumber} saved.";

            if (PrintAfterSave)
            {
                Navigation.NavigateTo(
                    $"/quotes/{quote.Id}/print",
                    forceLoad: true);
            }
            else
            {
                Navigation.NavigateTo(
                    $"/quotes/{quote.Id}",
                    forceLoad: true);
            }
        }
        catch (Exception exception)
        {
            ErrorMessage = $"The quote could not be saved. {exception.Message}";
        }
        finally
        {
            Saving = false;
            PrintAfterSave = false;
        }
    }

    private void MapToEntity(CustomerQuote quote, string? userId)
    {
        quote.Status = Model.Status;
        quote.Audience = Model.Audience;
        quote.ContractorTier = Model.ContractorTier;
        quote.CustomerName = Model.CustomerName.Trim();
        quote.CompanyName = Clean(Model.CompanyName);
        quote.Email = Clean(Model.Email);
        quote.Phone = Clean(Model.Phone);
        quote.AddressLine1 = Clean(Model.AddressLine1);
        quote.AddressLine2 = Clean(Model.AddressLine2);
        quote.City = Clean(Model.City);
        quote.State = Clean(Model.State);
        quote.PostalCode = Clean(Model.PostalCode);
        quote.IsContractor = Model.Audience == QuoteAudience.Contractor;
        quote.IsTaxExempt = Model.IsTaxExempt;
        quote.ShopifyCompanyId = Clean(Model.ShopifyCompanyId);
        quote.ShopifyCompanyContactId =
            Clean(Model.ShopifyCompanyContactId);
        quote.ShopifyCompanyLocationId =
            Clean(Model.ShopifyCompanyLocationId);
        quote.PaymentTermsName = Clean(Model.PaymentTermsName);
        quote.PaymentTermsTemplateId =
            Clean(Model.PaymentTermsTemplateId);
        quote.PaymentTermsDueInDays = Model.PaymentTermsDueInDays;
        quote.BillingAddressLine1 = Clean(Model.BillingAddressLine1);
        quote.BillingAddressLine2 = Clean(Model.BillingAddressLine2);
        quote.BillingCity = Clean(Model.BillingCity);
        quote.BillingState = Clean(Model.BillingState);
        quote.BillingPostalCode = Clean(Model.BillingPostalCode);
        quote.BillingCountry = Clean(Model.BillingCountry);
        quote.Subtotal = Subtotal;
        quote.CalculatedDeliveryAmount =
            Model.CalculatedDeliveryAmount;
        quote.CustomDeliveryAmount = Model.CustomDeliveryAmount;
        quote.RatePerMinute = Model.RatePerMinute;
        quote.ShippingQuantity = Model.ShippingQuantity;
        quote.ShippingRate = Model.ShippingRate;
        quote.ShippingUnit = Clean(Model.ShippingUnit);
        quote.DeliveryAmount = EffectiveDeliveryAmount;
        quote.TaxRate = Model.IsTaxExempt
            ? 0m
            : Math.Max(0m, Model.TaxRatePercent) / 100m;
        quote.TaxAmount = TaxAmount;
        quote.Total = Total;
        quote.DeliveryServiceName = Clean(Model.DeliveryServiceName);
        quote.DeliveryDescription = Clean(Model.DeliveryDescription);
        quote.DeliveryEta = Clean(Model.DeliveryEta);
        quote.DeliverySummary = Clean(Model.DeliverySummary);
        quote.SourceBreakdownJson = Clean(Model.SourceBreakdownJson);
        quote.CustomerNotes = Clean(Model.CustomerNotes);
        quote.InternalNotes = Clean(Model.InternalNotes);
        quote.UpdatedAtUtc = DateTime.UtcNow;
        quote.UpdatedByUserId = userId;
        quote.Lines = Model.Lines.Select((line, index) =>
            new CustomerQuoteLine
            {
                ProductId = line.ProductId,
                ProductVariantId = line.ProductVariantId,
                Description = line.Description.Trim(),
                Sku = Clean(line.Sku),
                Vendor = Clean(line.Vendor),
                ProductHandle = Clean(line.ProductHandle),
                ImageUrl = Clean(line.ImageUrl),
                ShopifyVariantIdSnapshot =
                    Clean(line.ShopifyVariantIdSnapshot),
                UnitLabel = line.UnitLabel.Trim(),
                PricingLabel = line.PricingLabel,
                Audience = Model.Audience,
                ContractorTier = Model.Audience == QuoteAudience.Contractor
                    ? Model.ContractorTier
                    : null,
                Quantity = Math.Max(0m, line.Quantity),
                UnitPrice = Math.Max(0m, line.UnitPrice),
                LineTotal = GetLineTotal(line),
                SortOrder = index
            }).ToList();
    }

    private static decimal GetLineTotal(QuoteLineEditModel line) =>
        Math.Round(
            Math.Max(0m, line.Quantity) * Math.Max(0m, line.UnitPrice),
            2);

    private static string GetDefaultUnit(Product product) =>
        product.MaterialProfile?.SoldBy switch
        {
            MaterialSoldBy.CubicYard => "yard",
            MaterialSoldBy.Ton => "ton",
            _ => "unit"
        };

