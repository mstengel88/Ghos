@page "/quotes/new"
@page "/quotes/{QuoteId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GhosPolicies.Operations)]
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject QuoteDeliveryService DeliveryService
@inject DispatchQuoteDataSyncService DispatchQuoteDataSyncService
@inject ShopifySyncService ShopifySyncService
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "New quote" : Model.QuoteNumber) | GHOS</PageTitle>

<div class="quote-heading">
    <div>
        <a href="/quotes">← Quote history</a>
        <span class="panel-label">QUOTE TOOL</span>
        <h2>@(IsNew ? "Build a delivery quote" : $"Edit {Model.QuoteNumber}")</h2>
        <p>Integrated V2 quoting using synced Shopify products, shared project calculators, and Dispatch route timing.</p>
    </div>
    <div class="heading-actions">
        @if (!string.IsNullOrWhiteSpace(DispatchSyncMessage))
        {
            <span class="sync-note">@DispatchSyncMessage</span>
        }
        @if (!IsNew)
        {
            <a class="secondary-action" href="/quotes/@QuoteId/print" target="_blank">Print quote</a>
            <span class="quote-number">@Model.Status</span>
        }
    </div>
</div>

@if (Loading)
{
    <section class="panel loading-panel">Preparing Shopify products and quote history…</section>
}
else if (NotFound)
{
    <section class="panel loading-panel">
        <h3>Quote not found</h3>
        <a href="/quotes">Return to quote history</a>
    </section>
}
else
{
    <EditForm Model="Model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="auth-alert" role="alert">@ErrorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="quote-success" role="status">@SuccessMessage</div>
        }

        <div class="quote-layout">
            <div class="quote-form-panel">
                <div class="audience-picker" role="tablist" aria-label="Pricing type">
                    @foreach (var audience in Enum.GetValues<QuoteAudience>())
                    {
                        <button type="button"
                                role="tab"
                                aria-selected="@(Model.Audience == audience)"
                                class="@(Model.Audience == audience ? "active" : null)"
                                @onclick="() => ChangeAudience(audience)">
                            <strong>@GetAudienceTitle(audience)</strong>
                            <span>@GetAudienceDescription(audience)</span>
                        </button>
                    }
                </div>

                <div class="quote-sections">
                <section class="form-section">
                    <div class="section-heading">
                        <span>01</span>
                        <div>
                            <h3>@(Model.Audience == QuoteAudience.Contractor
                                ? "Company & contact"
                                : "Customer")</h3>
                            <p>Who the quote is for and where the materials are going.</p>
                        </div>
                    </div>

                    @if (Model.Audience == QuoteAudience.Contractor)
                    {
                        <div class="contractor-strip">
                            <label>
                                <span>Shopify B2B company</span>
                                <select value="@SelectedCompanyExternalId"
                                        @onchange="CompanyChanged">
                                    <option value="">Choose a company…</option>
                                    @foreach (var company in B2BCompanies)
                                    {
                                        <option value="@company.ExternalId">
                                            @company.CompanyName
                                        </option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Contractor price level</span>
                                <InputSelect @bind-Value="Model.ContractorTier"
                                             @bind-Value:after="ApplyAudiencePricing">
                                    <option value="@ContractorTier.Tier1">Contractor Tier 1</option>
                                    <option value="@ContractorTier.Tier2">Contractor Tier 2</option>
                                </InputSelect>
                            </label>
                            <div>
                                <span>Shopify B2B</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.ShopifyCompanyId)
                                    ? "Company can be entered now"
                                    : "Company linked")</strong>
                            </div>
                        </div>
                    }

                    <div class="form-grid">
                        <label>
                            <span>Customer / contact name</span>
                            <InputText @bind-Value="Model.CustomerName" />
                        </label>
                        <label>
                            <span>Company</span>
                            <InputText @bind-Value="Model.CompanyName" />
                        </label>
                        <label>
                            <span>Email</span>
                            <InputText @bind-Value="Model.Email" type="email" />
                        </label>
                        <label>
                            <span>Phone</span>
                            <InputText @bind-Value="Model.Phone" type="tel" />
                        </label>
                        <label class="wide">
                            <span>Delivery address</span>
                            <InputText @bind-Value="Model.AddressLine1" />
                        </label>
                        <label class="wide">
                            <span>Address line 2</span>
                            <InputText @bind-Value="Model.AddressLine2" />
                        </label>
                        <label>
                            <span>City</span>
                            <InputText @bind-Value="Model.City" />
                        </label>
                        <label>
                            <span>State</span>
                            <InputText @bind-Value="Model.State" />
                        </label>
                        <label>
                            <span>ZIP code</span>
                            <InputText @bind-Value="Model.PostalCode" />
                        </label>
                        <label class="check-field">
                            <InputCheckbox @bind-Value="Model.IsTaxExempt" />
                            <span>Tax exempt</span>
                        </label>
                    </div>

                    @if (Model.Audience == QuoteAudience.Contractor)
                    {
                        <details class="billing-details">
                            <summary>Billing address and payment terms</summary>
                            <div class="form-grid">
                                <label class="wide">
                                    <span>Billing address</span>
                                    <InputText @bind-Value="Model.BillingAddressLine1" />
                                </label>
                                <label class="wide">
                                    <span>Billing address line 2</span>
                                    <InputText @bind-Value="Model.BillingAddressLine2" />
                                </label>
                                <label>
                                    <span>Billing city</span>
                                    <InputText @bind-Value="Model.BillingCity" />
                                </label>
                                <label>
                                    <span>Billing state</span>
                                    <InputText @bind-Value="Model.BillingState" />
                                </label>
                                <label>
                                    <span>Billing ZIP</span>
                                    <InputText @bind-Value="Model.BillingPostalCode" />
                                </label>
                                <label>
                                    <span>Payment terms</span>
                                    <InputText @bind-Value="Model.PaymentTermsName"
                                               placeholder="Due on receipt, Net 30…" />
                                </label>
                            </div>
                        </details>
                    }
                </section>

                <section class="form-section">
                    <div class="section-heading">
                        <span>02</span>
                        <div>
                            <h3>Products & materials</h3>
                            <p>Search Shopify products and variants. Each line preserves its quoted price and pricing source.</p>
                        </div>
                    </div>

                    <div class="product-search">
                        <label>
                            <span>Search by product, SKU, or vendor</span>
                            <input @bind="ProductSearch"
                                   @bind:event="oninput"
                                   placeholder="Start typing…" />
                        </label>
                        <select @bind="SelectedOptionKey">
                            <option value="">Choose a matching product…</option>
                            @foreach (var option in FilteredProductOptions)
                            {
                                <option value="@option.Key">
                                    @option.Label · @GetOptionPrice(option).ToString("C2")
                                </option>
                            }
                        </select>
                        <button type="button"
                                disabled="@string.IsNullOrWhiteSpace(SelectedOptionKey)"
                                @onclick="AddSelectedLine">
                            + Add product
                        </button>
                    </div>

                    @if (Model.Lines.Count == 0)
                    {
                        <div class="line-empty">
                            <strong>No products added</strong>
                            <span>Add a Shopify item or use the material calculator.</span>
                        </div>
                    }
                    else
                    {
                        <div class="quote-lines">
                            @foreach (var line in Model.Lines)
                            {
                                <article class="quote-line">
                                    @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                                    {
                                        <img src="@line.ImageUrl" alt="" />
                                    }
                                    else
                                    {
                                        <div class="line-image-placeholder">GH</div>
                                    }
                                    <div class="line-main">
                                        <InputText @bind-Value="line.Description" />
                                        <span>@line.Sku · @line.Vendor · @line.PricingLabel</span>
                                        <div class="line-actions">
                                            <button type="button"
                                                    @onclick="() => ToggleCalculator(line)">
                                                @GetCalculatorLabel(line)
                                            </button>
                                            @if (!string.IsNullOrWhiteSpace(line.ProductHandle))
                                            {
                                                <a href="https://www.greenhillssupply.com/products/@line.ProductHandle"
                                                   target="_blank"
                                                   rel="noopener">Product page</a>
                                            }
                                        </div>
                                    </div>
                                    <label>
                                        <span>Quantity</span>
                                        <InputNumber @bind-Value="line.Quantity" />
                                    </label>
                                    <label>
                                        <span>Unit</span>
                                        <InputText @bind-Value="line.UnitLabel" />
                                    </label>
                                    <label>
                                        <span>Unit price</span>
                                        <InputNumber @bind-Value="line.UnitPrice"
                                                     disabled="@(Model.Audience != QuoteAudience.Custom)" />
                                    </label>
                                    <strong class="line-total">@GetLineTotal(line).ToString("C2")</strong>
                                    <button type="button"
                                            class="remove-line"
                                            title="Remove line"
                                            @onclick="() => RemoveLine(line)">×</button>

                                    @if (ActiveCalculatorLineKey == line.Key)
                                    {
                                        var material = FindLineMaterial(line);
                                        var projectConfiguration =
                                            FindLineProjectConfiguration(line);
                                        <div class="line-calculator">
                                            <div class="calculator-topline">
                                                <strong>@(projectConfiguration?.Kind switch
                                                    {
                                                        ProjectCalculatorKind.Paver => "Paver calculator",
                                                        ProjectCalculatorKind.Wall => "Wall calculator",
                                                        _ => "Material calculator"
                                                    })</strong>
                                                <button type="button"
                                                        @onclick="() => ActiveCalculatorLineKey = null">Close</button>
                                            </div>
                                            <div class="shape-mini">
                                                @if (projectConfiguration?.Kind != ProjectCalculatorKind.Wall)
                                                {
                                                    <button type="button"
                                                            class="@(line.CalculatorShape == ProjectShape.Rectangle ? "active" : null)"
                                                            @onclick="() => line.CalculatorShape = ProjectShape.Rectangle">Rectangle</button>
                                                    <button type="button"
                                                            class="@(line.CalculatorShape == ProjectShape.Circle ? "active" : null)"
                                                            @onclick="() => line.CalculatorShape = ProjectShape.Circle">Circle</button>
                                                }
                                            </div>
                                            <div class="calculator-fields">
                                                @if (projectConfiguration?.Kind == ProjectCalculatorKind.Wall)
                                                {
                                                    <label><span>Wall length ft.</span><InputNumber @bind-Value="line.LengthFeet" /></label>
                                                    <label><span>Average height ft.</span><InputNumber @bind-Value="line.WallHeightFeet" /></label>
                                                    <label><span>Openings sq. ft.</span><InputNumber @bind-Value="line.OpeningsSqFt" /></label>
                                                }
                                                else if (line.CalculatorShape == ProjectShape.Rectangle)
                                                {
                                                    <label><span>Length ft.</span><InputNumber @bind-Value="line.LengthFeet" /></label>
                                                    <label><span>Width ft.</span><InputNumber @bind-Value="line.WidthFeet" /></label>
                                                }
                                                else
                                                {
                                                    <label><span>Diameter ft.</span><InputNumber @bind-Value="line.DiameterFeet" /></label>
                                                }
                                                @if (projectConfiguration is null)
                                                {
                                                    <label><span>Depth in.</span><InputNumber @bind-Value="line.DepthInches" /></label>
                                                    <label><span>Known yd³</span><InputNumber @bind-Value="line.ManualCubicYards" /></label>
                                                }
                                                <label>
                                                    <span>Extra</span>
                                                    <select @bind="line.ExtraPercent">
                                                        @foreach (var value in ExtraOptions)
                                                        {
                                                            <option value="@value">@value%</option>
                                                        }
                                                    </select>
                                                </label>
                                            </div>
                                            @if (projectConfiguration is null)
                                            {
                                                var calculation =
                                                    CalculateLine(line, material);
                                                <div class="calculator-result">
                                                    <span>@calculation.RecommendedCubicYards.ToString("0.00") yd³</span>
                                                    <strong>@calculation.OrderQuantity.ToString("0") @calculation.UnitLabel</strong>
                                                    <button type="button"
                                                            disabled="@(calculation.OrderQuantity <= 0)"
                                                            @onclick="() => ApplyCalculation(line, calculation)">
                                                        Use this quantity
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                var calculation =
                                                    CalculateProjectLine(
                                                        line,
                                                        projectConfiguration);
                                                <div class="calculator-result">
                                                    <span>@calculation.RequiredAreaSqFt.ToString("0.00") sq. ft.</span>
                                                    <strong>@calculation.OrderQuantity.ToString("0") @calculation.OrderUnitLabel</strong>
                                                    @if (projectConfiguration.IsStandardDiscover &&
                                                         calculation.RecommendedTotalLayers > 0)
                                                    {
                                                        <small>@calculation.RecommendedPurchase · @calculation.RecommendedTotalLayers total layers</small>
                                                    }
                                                    @if (projectConfiguration.Kind == ProjectCalculatorKind.Wall &&
                                                         calculation.EstimatedFullBlocks > 0)
                                                    {
                                                        <small>@calculation.EstimatedFullBlocks full blocks · @calculation.EstimatedCourses courses; corners and caps separate</small>
                                                    }
                                                    <button type="button"
                                                            disabled="@(calculation.OrderQuantity <= 0)"
                                                            @onclick="() => ApplyProjectCalculation(line, calculation)">
                                                        Use this quantity
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>

                <section class="form-section">
                    <div class="section-heading">
                        <span>03</span>
                        <div>
                            <h3>Delivery & adjustments</h3>
                            <p>Use Dispatch v2’s round-trip material routing or override the charge for a custom quote.</p>
                        </div>
                    </div>

                    <div class="delivery-actions">
                        <button type="button"
                                disabled="@CalculatingDelivery"
                                @onclick="CalculateDeliveryAsync">
                            @(CalculatingDelivery ? "Calculating route…" : "Calculate delivery")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Model.DeliverySummary))
                        {
                            <div>
                                <strong>@Model.DeliveryServiceName</strong>
                                <span>@Model.DeliverySummary · @Model.DeliveryEta</span>
                            </div>
                        }
                    </div>

                    <div class="form-grid adjustments">
                        <label>
                            <span>Delivery amount override</span>
                            <InputNumber @bind-Value="Model.CustomDeliveryAmount" />
                            <small>Leave blank to use the calculated amount.</small>
                        </label>
                        <label>
                            <span>Minute charge</span>
                            <InputNumber @bind-Value="Model.RatePerMinute" />
                            <small>Dispatch v2 default: $2.08/minute.</small>
                        </label>
                        <label>
                            <span>Custom shipping quantity</span>
                            <InputNumber @bind-Value="Model.ShippingQuantity" />
                        </label>
                        <label>
                            <span>Shipping unit</span>
                            <InputText @bind-Value="Model.ShippingUnit"
                                       placeholder="miles, hours…" />
                        </label>
                        <label>
                            <span>Price per shipping unit</span>
                            <InputNumber @bind-Value="Model.ShippingRate" />
                            <small>Quantity × rate replaces delivery when both are entered.</small>
                        </label>
                        <label>
                            <span>Tax rate (%)</span>
                            <InputNumber @bind-Value="Model.TaxRatePercent"
                                         disabled="@Model.IsTaxExempt" />
                            <small>Tax applies to products, not delivery.</small>
                        </label>
                    </div>
                </section>

                <section class="form-section">
                    <div class="section-heading">
                        <span>04</span>
                        <div>
                            <h3>Quote notes</h3>
                            <p>Separate customer-facing terms from internal Green Hills notes.</p>
                        </div>
                    </div>
                    <div class="form-grid">
                        <label>
                            <span>Customer notes / terms</span>
                            <InputTextArea @bind-Value="Model.CustomerNotes" rows="5" />
                        </label>
                        <label>
                            <span>Internal notes</span>
                            <InputTextArea @bind-Value="Model.InternalNotes" rows="5" />
                        </label>
                    </div>
                </section>
                </div>
            </div>

            <aside class="panel totals-panel">
                <span class="panel-label">FULL QUOTE RESULT</span>
                <h3>Quote summary</h3>
                <label>
                    <span>Status</span>
                    <InputSelect @bind-Value="Model.Status">
                        @foreach (var status in Enum.GetValues<QuoteStatus>())
                        {
                            <option value="@status">@GetStatusLabel(status)</option>
                        }
                    </InputSelect>
                </label>
                <div class="price-source">
                    <span>Pricing</span>
                    <strong>@QuotePricing.GetPricingLabel(Model.Audience, Model.ContractorTier)</strong>
                </div>
                <dl>
                    <div>
                        <dt>Products</dt>
                        <dd>@Subtotal.ToString("C2")</dd>
                    </div>
                    <div>
                        <dt>@(HasCustomShippingCalculation ? "Shipping" : "Delivery")</dt>
                        <dd>@EffectiveDeliveryAmount.ToString("C2")</dd>
                    </div>
                    <div>
                        <dt>Tax</dt>
                        <dd>@TaxAmount.ToString("C2")</dd>
                    </div>
                    <div class="grand-total">
                        <dt>Total</dt>
                        <dd>@Total.ToString("C2")</dd>
                    </div>
                </dl>
                @if (HasCustomShippingCalculation)
                {
                    <p class="shipping-math">@Model.ShippingQuantity × @Model.ShippingRate?.ToString("C2") per @Model.ShippingUnit</p>
                }

                <button type="submit" disabled="@Saving">
                    @(Saving ? "Saving…" : IsNew ? "Save quote" : "Save changes")
                </button>
                <button type="button"
                        class="secondary-save"
                        disabled="@Saving"
                        @onclick="SaveAndPrintAsync">
                    Save & print
                </button>
                @if (!IsNew)
                {
                    <button type="button"
                            class="shopify-draft"
                            disabled
                            title="Requires Shopify write_draft_orders permission">
                        Send to Shopify
                    </button>
                    <small>Shopify conversion is ready to be enabled after the app receives <code>write_draft_orders</code>. Your current read-only product/customer connection remains unchanged.</small>
                }
                else
                {
                    <small>Saving stores exact product, pricing, delivery, and calculator snapshots.</small>
                }
            </aside>
        </div>
    </EditForm>
}

@code {
    private static readonly int[] ExtraOptions = [0, 5, 10, 15, 20];

    [Parameter]
    public Guid? QuoteId { get; set; }

    [SupplyParameterFromQuery(Name = "productId")]
    public Guid? InitialProductId { get; set; }

    [SupplyParameterFromQuery(Name = "variantId")]
    public Guid? InitialVariantId { get; set; }

    [SupplyParameterFromQuery(Name = "quantity")]
    public decimal? InitialQuantity { get; set; }

    private bool IsNew => QuoteId is null;
    private bool Loading { get; set; } = true;
    private bool NotFound { get; set; }
    private bool Saving { get; set; }
    private bool CalculatingDelivery { get; set; }
    private bool PrintAfterSave { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? DispatchSyncMessage { get; set; }
    private string SelectedOptionKey { get; set; } = string.Empty;
    private string SelectedCompanyExternalId { get; set; } = string.Empty;
    private string ProductSearch { get; set; } = string.Empty;
    private Guid? ActiveCalculatorLineKey { get; set; }
    private QuoteEditModel Model { get; set; } = new();
    private List<ProductOption> ProductOptions { get; set; } = [];
    private List<QuoteB2BCompany> B2BCompanies { get; set; } = [];

    private IEnumerable<ProductOption> FilteredProductOptions =>
        ProductOptions.Where(option =>
                string.IsNullOrWhiteSpace(ProductSearch) ||
                option.Label.Contains(ProductSearch, StringComparison.OrdinalIgnoreCase) ||
                (option.Sku?.Contains(ProductSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (option.Vendor?.Contains(ProductSearch, StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(100);
    private decimal Subtotal => Model.Lines.Sum(GetLineTotal);
    private bool HasCustomShippingCalculation =>
        Model.ShippingQuantity.GetValueOrDefault() > 0 &&
        Model.ShippingRate.GetValueOrDefault() > 0;
    private decimal EffectiveDeliveryAmount => HasCustomShippingCalculation
        ? Math.Round(
            Model.ShippingQuantity!.Value * Model.ShippingRate!.Value,
            2)
        : Model.CustomDeliveryAmount is not null
            ? Math.Max(0m, Model.CustomDeliveryAmount.Value)
            : Math.Max(0m, Model.CalculatedDeliveryAmount.GetValueOrDefault());
    private decimal TaxAmount => Model.IsTaxExempt
        ? 0m
        : Math.Round(Subtotal * Math.Max(0m, Model.TaxRatePercent) / 100m, 2);
    private decimal Total =>
        Math.Round(Subtotal + EffectiveDeliveryAmount + TaxAmount, 2);

    protected override async Task OnInitializedAsync()
    {
        var initialAuthenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        try
        {
            await ShopifySyncService.SynchronizeIfStaleAsync(
                initialAuthenticationState.User);
        }
        catch
        {
            // Existing quotes remain usable when Shopify is temporarily unavailable.
        }

        try
        {
            var syncResult =
                await DispatchQuoteDataSyncService.SynchronizeIfStaleAsync();
            if (syncResult is not null)
            {
                DispatchSyncMessage =
                    $"{syncResult.Products} products · " +
                    $"{syncResult.Companies} companies · " +
                    $"{syncResult.ExistingQuotes + syncResult.ImportedQuotes} saved quotes";
            }
        }
        catch (Exception exception)
        {
            DispatchSyncMessage =
                $"Dispatch data unavailable: {exception.Message}";
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var products = await dbContext.Products
            .AsNoTracking()
            .Include(product => product.Variants)
            .Include(product => product.MaterialProfile)
            .Where(product => product.Status == ProductStatus.Active)
            .OrderBy(product => product.Name)
            .ToListAsync();
        var configuration = await dbContext.QuoteConfigurations
            .AsNoTracking()
            .SingleOrDefaultAsync();
        Model.TaxRatePercent =
            (configuration?.DefaultTaxRate ?? .055m) * 100m;
        Model.RatePerMinute =
            configuration?.DefaultRatePerMinute ?? 2.08m;
        B2BCompanies = await dbContext.QuoteB2BCompanies
            .AsNoTracking()
            .OrderBy(company => company.CompanyName)
            .ToListAsync();

        ProductOptions = products
            .SelectMany(product =>
                product.Variants.Count == 0
                    ? [new ProductOption(
                        product.Id.ToString(),
                        product.Id,
                        null,
                        product.Name,
                        product.Name,
                        product.ProductCode,
                        product.ShopifyVendor,
                        product.ShopifyHandle,
                        product.ShopifyFeaturedImageUrl,
                        string.Empty,
                        0m,
                        null,
                        null,
                        GetDefaultUnit(product),
                        PaverWallCalculator.Resolve(product))]
                    : product.Variants
                        .OrderBy(variant => variant.SortOrder)
                        .Select(variant => new ProductOption(
                            variant.Id.ToString(),
                            product.Id,
                            variant.Id,
                            variant.Title.Equals(
                                "Default Title",
                                StringComparison.OrdinalIgnoreCase)
                                ? product.Name
                                : $"{product.Name} — {variant.Title}",
                            product.Name,
                            variant.Sku ?? product.ProductCode,
                            variant.PickupVendor ?? product.ShopifyVendor,
                            product.ShopifyHandle,
                            variant.ImageUrl ?? product.ShopifyFeaturedImageUrl,
                            variant.ShopifyVariantId,
                            variant.Price,
                            variant.ContractorTier1Price,
                            variant.ContractorTier2Price,
                            variant.UnitLabel ?? GetDefaultUnit(product),
                            PaverWallCalculator.Resolve(product, variant))))
            .ToList();

        if (QuoteId is not null)
        {
            var quote = await dbContext.CustomerQuotes
                .AsNoTracking()
                .Include(item => item.Lines.OrderBy(line => line.SortOrder))
                .SingleOrDefaultAsync(item => item.Id == QuoteId);
            if (quote is null)
            {
                NotFound = true;
                Loading = false;
                return;
            }

            Model = QuoteEditModel.FromEntity(quote);
            SelectedCompanyExternalId = B2BCompanies
                .FirstOrDefault(company =>
                    company.ShopifyCompanyId == Model.ShopifyCompanyId &&
                    (!string.IsNullOrWhiteSpace(
                        Model.ShopifyCompanyLocationId)
                        ? company.ShopifyCompanyLocationId ==
                          Model.ShopifyCompanyLocationId
                        : true))
                ?.ExternalId ?? string.Empty;
        }
        else if (InitialProductId is not null)
        {
            var option = ProductOptions.FirstOrDefault(item =>
                item.ProductId == InitialProductId &&
                (InitialVariantId is null ||
                 item.ProductVariantId == InitialVariantId)) ??
                ProductOptions.FirstOrDefault(item =>
                    item.ProductId == InitialProductId);
            if (option is not null)
            {
                AddLine(option, InitialQuantity.GetValueOrDefault(1m));
            }
        }

        Loading = false;
    }

    private void CompanyChanged(ChangeEventArgs args)
    {
        SelectedCompanyExternalId =
            args.Value?.ToString() ?? string.Empty;
        var company = B2BCompanies.FirstOrDefault(candidate =>
            candidate.ExternalId == SelectedCompanyExternalId);
        if (company is null)
        {
            return;
        }

        Model.CompanyName = company.CompanyName;
        Model.CustomerName = company.ContactName ?? Model.CustomerName;
        Model.Email = company.Email ?? Model.Email;
        Model.Phone = company.Phone ?? Model.Phone;
        Model.ContractorTier = company.ContractorTier;
        Model.IsTaxExempt = company.IsTaxExempt;
        Model.ShopifyCompanyId = company.ShopifyCompanyId;
        Model.ShopifyCompanyContactId =
            company.ShopifyCompanyContactId;
        Model.ShopifyCompanyLocationId =
            company.ShopifyCompanyLocationId;
        Model.PaymentTermsName = company.PaymentTermsName;
        Model.PaymentTermsTemplateId =
            company.PaymentTermsTemplateId;
        Model.PaymentTermsDueInDays =
            company.PaymentTermsDueInDays;
        Model.BillingAddressLine1 =
            company.BillingAddressLine1;
        Model.BillingAddressLine2 =
            company.BillingAddressLine2;
        Model.BillingCity = company.BillingCity;
        Model.BillingState = company.BillingState ?? "WI";
        Model.BillingPostalCode = company.BillingPostalCode;
        Model.BillingCountry = company.BillingCountry ?? "US";
        ApplyAudiencePricing();
    }

    private void ChangeAudience(QuoteAudience audience)
    {
        Model.Audience = audience;
        ApplyAudiencePricing();
    }

    private void ApplyAudiencePricing()
    {
        foreach (var line in Model.Lines)
        {
            var option = ProductOptions.FirstOrDefault(candidate =>
                candidate.ProductVariantId == line.ProductVariantId ||
                candidate.ProductId == line.ProductId);
            if (option is null || Model.Audience == QuoteAudience.Custom)
            {
                line.PricingLabel = QuotePricing.GetPricingLabel(
                    Model.Audience,
                    Model.ContractorTier);
                continue;
            }

            line.UnitPrice = GetOptionPrice(option);
            line.PricingLabel = QuotePricing.GetPricingLabel(
                Model.Audience,
                Model.ContractorTier);
        }
    }

    private decimal GetOptionPrice(ProductOption option) =>
        QuotePricing.GetUnitPrice(
            option.RetailPrice,
            option.ContractorTier1Price,
            option.ContractorTier2Price,
            Model.Audience,
            Model.ContractorTier);

    private void AddSelectedLine()
    {
        var option = ProductOptions.FirstOrDefault(item =>
            item.Key == SelectedOptionKey);
        if (option is null)
        {
            return;
        }

        AddLine(option, 1m);
        SelectedOptionKey = string.Empty;
    }

    private void AddLine(ProductOption option, decimal quantity)
    {
        Model.Lines.Add(new QuoteLineEditModel
        {
            ProductId = option.ProductId,
            ProductVariantId = option.ProductVariantId,
            ShopifyVariantIdSnapshot = option.ShopifyVariantId,
            Description = option.Description,
            ProductName = option.ProductName,
            Sku = option.Sku,
            Vendor = option.Vendor,
            ProductHandle = option.ProductHandle,
            ImageUrl = option.ImageUrl,
            UnitLabel = option.UnitLabel,
            ProjectConfiguration = option.ProjectConfiguration,
            PricingLabel = QuotePricing.GetPricingLabel(
                Model.Audience,
                Model.ContractorTier),
            Quantity = Math.Max(quantity, 0m),
            UnitPrice = GetOptionPrice(option)
        });
    }

    private void RemoveLine(QuoteLineEditModel line) => Model.Lines.Remove(line);

    private void ToggleCalculator(QuoteLineEditModel line) =>
        ActiveCalculatorLineKey =
            ActiveCalculatorLineKey == line.Key ? null : line.Key;

