        };

    private static string GetAudienceDescription(QuoteAudience audience) =>
        audience switch
        {
            QuoteAudience.Contractor => "Tier pricing and B2B terms",
            QuoteAudience.Custom => "Editable titles and prices",
            _ => "Retail Shopify pricing"
        };

