@page "/products"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>Products | GHOS</PageTitle>

<div class="module-heading">
    <div>
        <span class="panel-label">PRODUCT INFORMATION MANAGEMENT</span>
        <h2>Product catalog</h2>
        <p>Manage the approved names, categories, synonyms, availability, and customer-facing information used throughout GHOS.</p>
    </div>

    <div class="module-actions">
        @if (NeedsReviewCount > 0)
        {
            <AuthorizeView Policy="@GhosPolicies.Operations">
                <a class="review-link" href="/products?review=needed">
                    Review imports <span>@NeedsReviewCount</span>
                </a>
            </AuthorizeView>
        }
        <AuthorizeView Policy="@GhosPolicies.AdministratorOnly">
            <a class="secondary-link" href="/products/shopify">Sync Shopify</a>
        </AuthorizeView>
        <AuthorizeView Policy="@GhosPolicies.Operations">
            <a class="secondary-link" href="/products/bulk">Bulk edit</a>
            <a class="primary-action" href="/products/new">+ Add product</a>
        </AuthorizeView>
    </div>
</div>

@if (Saved)
{
    <div class="module-notice" role="status">Product information saved successfully.</div>
}
else if (ReviewCompleted)
{
    <div class="module-notice" role="status">
        Review queue complete. Every Shopify product has been reviewed.
    </div>
}

<section class="catalog-summary">
    <article>
        <span>Total products</span>
        <strong>@AllProducts.Count</strong>
    </article>
    <article>
        <span>Active</span>
        <strong>@AllProducts.Count(product => product.Status == ProductStatus.Active)</strong>
    </article>
    <article>
        <span>Needs review</span>
        <strong>@NeedsReviewCount</strong>
    </article>
    <article>
        <span>With approved media</span>
        <strong>@AllProducts.Count(HasApprovedMedia)</strong>
    </article>
    <article>
        <span>Primary image set</span>
        <strong>@AllProducts.Count(HasPrimaryImage)</strong>
    </article>
</section>

<section class="panel catalog-panel">
    <div class="catalog-toolbar">
        <label class="search-field">
            <span>Search products</span>
            <input @bind="SearchText"
                   @bind:event="oninput"
                   type="search"
                   placeholder="Name, product code, or alternate name" />
        </label>

        <label>
            <span>Category</span>
            <select @bind="SelectedCategory">
                <option value="">All categories</option>
                @foreach (var category in Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </label>

        <label>
            <span>Status</span>
            <select @bind="SelectedStatus">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<ProductStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </label>

        <label>
            <span>Review</span>
            <select @bind="SelectedReview">
                <option value="">All products</option>
                <option value="needed">Needs review</option>
                <option value="reviewed">Reviewed</option>
            </select>
        </label>
    </div>

    @if (Loading)
    {
        <div class="catalog-empty">Loading the product catalog…</div>
    }
    else if (FilteredProducts.Count == 0)
    {
        <div class="catalog-empty">
            <div class="empty-icon">◆</div>
            <h3>@(AllProducts.Count == 0 ? "Build the product source of truth" : "No products match these filters")</h3>
            <p>@(AllProducts.Count == 0
                ? "Start with an approved product name and add alternate terms customers use when searching."
                : "Try a broader search or clear one of the filters.")</p>
            @if (AllProducts.Count == 0)
            {
                <AuthorizeView Policy="@GhosPolicies.Operations">
                    <a class="primary-action" href="/products/new">Add the first product</a>
                </AuthorizeView>
            }
        </div>
    }
    else
    {
        <div class="catalog-table-wrap">
            <table class="catalog-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Availability</th>
                        <th>Price</th>
                        <th>Media</th>
                        <th>Completeness</th>
                        <th>Status</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in FilteredProducts)
                    {
                        var completeness = ProductCompleteness.Calculate(product);
                        <tr>
                            <td>
                                <strong>@product.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(product.ProductCode))
                                {
                                    <small>@product.ProductCode</small>
                                }
                                @if (product.AlternateNames.Count > 0)
                                {
                                    <div class="synonyms">
                                        Also: @string.Join(", ", product.AlternateNames.Select(name => name.Name))
                                    </div>
                                }
                                @if (product.ShopifyProductId is not null)
                                {
                                    <div class="source-label">Shopify · @product.ShopifyHandle</div>
                                    <div class="review-state @(product.ReviewedAtUtc is null ? "needed" : "reviewed")">
                                        @(product.ReviewedAtUtc is null ? "Needs review" : "Reviewed")
                                    </div>
                                }
                            </td>
                            <td>@product.ProductCategory.Name</td>
                            <td>
                                <div class="availability">
                                    @if (product.AvailableForPickup) { <span>Pickup</span> }
                                    @if (product.AvailableForDelivery) { <span>Delivery</span> }
                                    @if (product.AvailableInBulk) { <span>Bulk</span> }
                                    @if (product.AvailableBagged) { <span>Bagged</span> }
                                </div>
                            </td>
                            <td>@FormatPrice(product)</td>
                            <td>
                                <div class="media-state @(HasPrimaryImage(product) ? "ready" : HasApprovedMedia(product) ? "partial" : "missing")">
                                    <strong>@product.AssetLinks.Count</strong>
                                    <span>
                                        @(HasPrimaryImage(product)
                                            ? "Primary ready"
                                            : HasApprovedMedia(product)
                                                ? "Choose primary"
                                                : product.AssetLinks.Count > 0
                                                    ? "Needs approval"
                                                    : "No media")
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="completeness">
                                    <div><span style="width:@completeness%"></span></div>
                                    <strong>@completeness%</strong>
                                </div>
                            </td>
                            <td><span class="status-badge @product.Status.ToString().ToLowerInvariant()">@product.Status</span></td>
                            <td>
                                <AuthorizeView Policy="@GhosPolicies.Operations">
                                    <a class="row-action" href="@GetEditorUrl(product)">Edit</a>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? SavedValue { get; set; }

    [SupplyParameterFromQuery(Name = "review")]
    public string? ReviewValue { get; set; }

    [SupplyParameterFromQuery(Name = "reviewComplete")]
    public string? ReviewCompleteValue { get; set; }

    private List<Product> AllProducts { get; set; } = [];
    private List<ProductCategory> Categories { get; set; } = [];
    private bool Loading { get; set; } = true;
    private string SearchText { get; set; } = string.Empty;
    private string SelectedCategory { get; set; } = string.Empty;
    private string SelectedStatus { get; set; } = string.Empty;
    private string SelectedReview { get; set; } = string.Empty;
    private bool Saved => SavedValue == "1";
    private bool ReviewCompleted => ReviewCompleteValue == "1";
    private int NeedsReviewCount => AllProducts.Count(product =>
        product.ShopifyProductId is not null && product.ReviewedAtUtc is null);

    private List<Product> FilteredProducts => AllProducts
        .Where(MatchesSearch)
        .Where(product =>
            string.IsNullOrWhiteSpace(SelectedCategory) ||
            product.ProductCategoryId.ToString() == SelectedCategory)
        .Where(product =>
            string.IsNullOrWhiteSpace(SelectedStatus) ||
            product.Status.ToString() == SelectedStatus)
        .Where(product =>
            string.IsNullOrWhiteSpace(SelectedReview) ||
            (SelectedReview == "needed" &&
                product.ShopifyProductId is not null &&
                product.ReviewedAtUtc is null) ||
            (SelectedReview == "reviewed" &&
                product.ShopifyProductId is not null &&
                product.ReviewedAtUtc is not null))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        Categories = await dbContext.ProductCategories
            .AsNoTracking()
            .Where(category => category.IsActive)
            .OrderBy(category => category.SortOrder)
            .ThenBy(category => category.Name)
            .ToListAsync();

        AllProducts = await dbContext.Products
            .AsNoTracking()
            .Include(product => product.ProductCategory)
            .Include(product => product.AlternateNames)
            .Include(product => product.Variants)
            .Include(product => product.AssetLinks)
                .ThenInclude(link => link.DigitalAsset)
            .AsSplitQuery()
            .OrderBy(product => product.Name)
            .ToListAsync();

        SelectedReview = ReviewValue is "needed" or "reviewed"
            ? ReviewValue
            : string.Empty;
        Loading = false;
    }

    private bool MatchesSearch(Product product)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return true;
        }

        var search = SearchText.Trim();
        return product.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            (product.ProductCode?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
            product.AlternateNames.Any(name =>
                name.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private string GetEditorUrl(Product product) =>
        SelectedReview == "needed"
            ? $"/products/{product.Id}/edit?review=1"
            : $"/products/{product.Id}/edit";

    private static string FormatPrice(Product product)
    {
        if (product.Variants.Count == 0)
        {
            return "—";
        }

        var prices = product.Variants
            .Select(variant => variant.Price)
            .Distinct()
            .ToList();
        var minimum = prices.Min();

        return prices.Count > 1 ? $"From {minimum:C}" : minimum.ToString("C");
    }

    private static bool HasApprovedMedia(Product product) =>
        product.AssetLinks.Any(link =>
            link.DigitalAsset.Kind == AssetKind.Image &&
            link.DigitalAsset.Status == AssetStatus.Approved);

    private static bool HasPrimaryImage(Product product) =>
        product.AssetLinks.Any(link =>
            link.IsPrimary &&
            link.DigitalAsset.Kind == AssetKind.Image &&
            link.DigitalAsset.Status == AssetStatus.Approved);
}
