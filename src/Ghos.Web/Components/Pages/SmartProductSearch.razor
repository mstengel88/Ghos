@page "/smart-search"
@rendermode InteractiveServer
@attribute [Authorize(Policy = GhosPolicies.Marketing)]
@inject SmartProductSearchService SearchService
@inject SmartSearchTuningService TuningService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService

<PageTitle>Smart Product Search | GHOS</PageTitle>

<div class="search-heading">
    <div>
        <span class="panel-label">SMART PRODUCT SEARCH</span>
        <h2>Help customers find the right material</h2>
        <p>Test the same intent-aware search that can power the Green Hills storefront.</p>
    </div>
    <div class="library-stat">
        <strong>@TotalMappingCount.ToString("N0")</strong>
        <span>landscape search mappings</span>
    </div>
</div>

<section class="panel search-lab">
    <label for="smart-search-query">What is the customer trying to find or build?</label>
    <div class="search-box">
        <input id="smart-search-query"
               @bind="Query"
               @bind:event="oninput"
               @onkeydown="HandleKeyDownAsync"
               type="search"
               placeholder="Try: gray stone for a driveway, patio base, drainage gravel…" />
        <button type="button"
                disabled="@(Searching || Query.Trim().Length < 2)"
                @onclick="SearchAsync">
            @(Searching ? "Searching…" : "Search products")
        </button>
    </div>
    <div class="examples">
        <span>Try:</span>
        @foreach (var example in Examples)
        {
            <button type="button" @onclick="() => SearchExampleAsync(example)">
                @example
            </button>
        }
    </div>
</section>

@if (Analytics is not null)
{
    <section class="analytics-strip">
        <article class="panel">
            <span>Searches · 7 days</span>
            <strong>@Analytics.Searches</strong>
        </article>
        <article class="panel">
            <span>Zero-result searches</span>
            <strong>@Analytics.ZeroResultSearches</strong>
        </article>
        <article class="panel">
            <span>Searches needing review</span>
            <strong>@Analytics.SearchesNeedingReview</strong>
        </article>
        <article class="panel">
            <span>Product selections</span>
            <strong>@Analytics.ProductSelections</strong>
        </article>
        <article class="panel">
            <span>Selection rate</span>
            <strong>@SelectionRate</strong>
        </article>
    </section>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="search-alert" role="alert">@ErrorMessage</div>
}

@if (Response is not null)
{
    <section class="search-summary">
        <div>
            <span>UNDERSTOOD AS</span>
            @if (Response.Intents.Count == 0)
            {
                <strong>Direct catalog match</strong>
            }
            else
            {
                <strong>@string.Join(" · ", Response.Intents)</strong>
            }
        </div>
        <strong>@Response.Results.Count result@(Response.Results.Count == 1 ? "" : "s")</strong>
    </section>

    @if (Response.Results.Count == 0)
    {
        <section class="panel no-results">
            <strong>No confident product matches</strong>
            <span>Try a use, project, material, color, or size. GHOS does not invent products that are not in Shopify.</span>
            @if (CanTuneSearch)
            {
                <button type="button" class="tune-shortcut" @onclick="() => PrepareRule(Query)">
                    Teach GHOS this phrase
                </button>
            }
        </section>
    }
    else
    {
        <section class="result-grid">
            @foreach (var result in Response.Results)
            {
                <article class="panel product-result">
                    @if (!string.IsNullOrWhiteSpace(result.ImageUrl))
                    {
                        <img src="@result.ImageUrl" alt="" loading="lazy" />
                    }
                    <div>
                        <h3>@result.Title</h3>
                        <span class="confidence @result.Confidence.ToLowerInvariant()">
                            @result.Confidence confidence
                        </span>
                        @if (result.StartingPrice is not null)
                        {
                            <strong class="price">From @result.StartingPrice.Value.ToString("C")</strong>
                        }
                        <p>@result.Description</p>
                        <div class="reasons">
                            @foreach (var reason in result.MatchReasons)
                            {
                                <span>@reason</span>
                            }
                        </div>
                        @if (result.UnmatchedIntents.Count > 0)
                        {
                            <small class="missing-intent">
                                Not confirmed: @string.Join(
                                    ", ",
                                    result.UnmatchedIntents.Select(
                                        intent => intent.Split(':', 2)[1].Trim()))
                            </small>
                        }
                        <a href="@result.ProductUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           @onclick="() => RecordSelectionAsync(result)">
                            View live product ↗
                        </a>
                    </div>
                </article>
            }
        </section>
    }
}

@if (Analytics is not null &&
    (Analytics.TopQueries.Count > 0 ||
        Analytics.ReviewQueries.Count > 0))
{
    <section class="search-insights">
        <article class="panel">
            <span class="panel-label">TOP SEARCHES · 7 DAYS</span>
            @if (Analytics.TopQueries.Count == 0)
            {
                <p>No searches recorded yet.</p>
            }
            else
            {
                @foreach (var item in Analytics.TopQueries)
                {
                    <button type="button"
                            @onclick="() => SearchExampleAsync(item.Query)">
                        <span>@item.Query</span>
                        <strong>@item.Searches</strong>
                    </button>
                }
            }
        </article>
        <article class="panel review-list">
            <span class="panel-label">SEARCHES NEEDING REVIEW</span>
            @if (Analytics.ReviewQueries.Count == 0)
            {
                <p>Every recent search returned a high-confidence match.</p>
            }
            else
            {
                @foreach (var item in Analytics.ReviewQueries)
                {
                    <div class="review-row">
                        <div class="review-title">
                            <button type="button"
                                    @onclick="() => SearchExampleAsync(item.Query)">
                                @item.Query
                            </button>
                            <span class="review-status @(item.ResultCount == 0 ? "none" : "weak")">
                                @(item.ResultCount == 0
                                    ? "No results"
                                    : $"{item.TopResultConfidence ?? "Lower"} confidence")
                            </span>
                            <strong>@item.Searches search@(item.Searches == 1 ? "" : "es")</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.TopResultTitle))
                        {
                            <p class="review-result">
                                Current top result: @item.TopResultTitle
                            </p>
                        }
                        <p>@item.Recommendation</p>
                        <div class="review-actions">
                            <button type="button"
                                    @onclick="() => SearchExampleAsync(item.Query)">
                                Test search
                            </button>
                            @if (CanTuneSearch && item.ResultCount == 0)
                            {
                                <button type="button"
                                        @onclick="() => PrepareRule(item.Query)">
                                    Create synonym rule
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </article>
    </section>
}

@if (CanTuneSearch)
{
    <section class="panel tuning-panel" id="search-tuning">
        <div class="tuning-heading">
            <div>
                <span class="panel-label">SEARCH TUNING</span>
                <h3>Teach GHOS customer language</h3>
                <p>Connect a phrase customers use to wording already found in your product catalog.</p>
            </div>
            <strong>@Rules.Count(rule => rule.IsActive) active rules</strong>
        </div>

        <div class="rule-builder">
            <label>
                Customer phrase
                <input @bind="NewPhrase"
                       maxlength="120"
                       placeholder="Example: crusher dust" />
            </label>
            <span aria-hidden="true">→</span>
            <label>
                Search as
                <input @bind="NewExpansion"
                       maxlength="120"
                       placeholder="Example: stone screenings" />
            </label>
            <button type="button"
                    disabled="@(TuningBusy ||
                        NewPhrase.Trim().Length < 2 ||
                        NewExpansion.Trim().Length < 2)"
                    @onclick="AddRuleAsync">
                @(TuningBusy ? "Saving…" : "Add rule")
            </button>
        </div>
        <p class="rule-help">
            Use a real product, material, or category phrase—not a sentence you want shown to customers.
        </p>

        @if (!string.IsNullOrWhiteSpace(TuningMessage))
        {
            <div class="tuning-message" role="status">@TuningMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(TuningError))
        {
            <div class="search-alert" role="alert">@TuningError</div>
        }

        @if (Rules.Count == 0)
        {
            <div class="empty-rules">
                No custom rules yet. Built-in landscape terminology remains active.
            </div>
        }
        else
        {
            <div class="rule-list">
                @foreach (var rule in Rules)
                {
                    <div class="rule-row @(rule.IsActive ? "" : "inactive")">
                        <div>
                            <strong>@rule.Phrase</strong>
                            <span>search as</span>
                            <strong>@rule.Expansion</strong>
                        </div>
                        <button type="button"
                                disabled="@TuningBusy"
                                @onclick="() => ToggleRuleAsync(rule)">
                            @(rule.IsActive ? "Disable" : "Enable")
                        </button>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private static readonly string[] Examples =
    [
        "stone for a driveway",
        "gray patio material",
        "gravel for drainage",
        "small decorative rock",
        "bulk ice melt"
    ];

    private string Query { get; set; } = "";
    private bool Searching { get; set; }
    private string? ErrorMessage { get; set; }
    private SmartProductSearchResponse? Response { get; set; }
    private SmartSearchAnalyticsSnapshot? Analytics { get; set; }
    private List<SmartSearchSynonymRule> Rules { get; set; } = [];
    private bool CanTuneSearch { get; set; }
    private string CurrentUserId { get; set; } = "";
    private string NewPhrase { get; set; } = "";
    private string NewExpansion { get; set; } = "";
    private bool TuningBusy { get; set; }
    private string? TuningMessage { get; set; }
    private string? TuningError { get; set; }

    private int TotalMappingCount =>
        SmartSearchSynonymLibrary.SynonymMappingCount +
        Rules.Count(rule => rule.IsActive);

    protected override async Task OnInitializedAsync()
    {
        Analytics = await SearchService.GetAnalyticsAsync();
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserId = authenticationState.User.FindFirstValue(
            ClaimTypes.NameIdentifier) ?? "";
        CanTuneSearch = (await AuthorizationService.AuthorizeAsync(
            authenticationState.User,
            GhosPolicies.Management)).Succeeded;
        if (CanTuneSearch)
        {
            await LoadRulesAsync();
        }
    }

    private async Task LoadRulesAsync() =>
        Rules = (await TuningService.GetRulesAsync()).ToList();

    private async Task HandleKeyDownAsync(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchExampleAsync(string example)
    {
        Query = example;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (Searching || Query.Trim().Length < 2)
        {
            return;
        }

        Searching = true;
        ErrorMessage = null;
        try
        {
            Response = await SearchService.SearchAsync(
                Query,
                12,
                "GHOS preview");
            Analytics = await SearchService.GetAnalyticsAsync();
        }
        catch
        {
            ErrorMessage =
                "GHOS could not search the synced Shopify catalog. Try again.";
        }
        finally
        {
            Searching = false;
        }
    }

    private void PrepareRule(string phrase)
    {
        NewPhrase = phrase.Trim();
        NewExpansion = "";
        TuningMessage = null;
        TuningError = null;
    }

    private async Task AddRuleAsync()
    {
        if (!CanTuneSearch || TuningBusy)
        {
            return;
        }

        TuningBusy = true;
        TuningMessage = null;
        TuningError = null;
        try
        {
            var added = await TuningService.AddRuleAsync(
                NewPhrase,
                NewExpansion,
                CurrentUserId);
            NewPhrase = "";
            NewExpansion = "";
            TuningMessage =
                $"GHOS will now search “{added.Expansion}” when a customer uses “{added.Phrase}”.";
            await LoadRulesAsync();
        }
        catch (ValidationException exception)
        {
            TuningError = exception.Message;
        }
        catch
        {
            TuningError =
                "GHOS could not save this search rule. Try again.";
        }
        finally
        {
            TuningBusy = false;
        }
    }

    private async Task ToggleRuleAsync(SmartSearchSynonymRule rule)
    {
        if (!CanTuneSearch || TuningBusy)
        {
            return;
        }

        TuningBusy = true;
        TuningMessage = null;
        TuningError = null;
        try
        {
            if (!await TuningService.SetActiveAsync(
                rule.Id,
                !rule.IsActive))
            {
                TuningError = "That search rule no longer exists.";
                return;
            }

            TuningMessage =
                $"Rule “{rule.Phrase}” was {(rule.IsActive ? "disabled" : "enabled")}.";
            await LoadRulesAsync();
        }
        catch
        {
            TuningError =
                "GHOS could not update this search rule. Try again.";
        }
        finally
        {
            TuningBusy = false;
        }
    }

    private async Task RecordSelectionAsync(
        SmartProductSearchResult result)
    {
        if (Response?.SearchEventId is not Guid searchEventId)
        {
            return;
        }

        await SearchService.RecordSelectionAsync(
            searchEventId,
            result.ProductId);
        Analytics = await SearchService.GetAnalyticsAsync();
    }

    private string SelectionRate =>
        Analytics is null || Analytics.Searches == 0
            ? "—"
            : $"{Analytics.ProductSelections * 100m / Analytics.Searches:0}%";
}
