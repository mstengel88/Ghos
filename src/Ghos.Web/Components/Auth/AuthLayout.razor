@inherits LayoutComponentBase

<main class="auth-shell">
    <section class="auth-brand">
        <div class="auth-brand-lockup">
            <div class="auth-brand-mark">GH</div>
            <div>
                <div class="auth-brand-name">GREEN HILLS</div>
                <div class="auth-brand-subtitle">OPERATING SYSTEM</div>
            </div>
        </div>

        <div class="auth-brand-copy">
            <span>SECURE COMPANY WORKSPACE</span>
            <h1>One place for the work that moves Green Hills forward.</h1>
            <p>Products, assets, marketing, playbooks, training, and operations—organized around one trusted source of truth.</p>
        </div>
    </section>

    <section class="auth-content">
        <div class="auth-content-inner">
            @Body
        </div>
        <footer>Green Hills Supply · GHOS Foundation</footer>
    </section>
</main>
