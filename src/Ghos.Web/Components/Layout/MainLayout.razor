@inherits LayoutComponentBase

<div class="ghos-app">
    <aside class="ghos-sidebar">
        <NavMenu />
    </aside>

    <main class="ghos-main">
        <header class="ghos-header">
            <div>
                <div class="ghos-page-label">GREEN HILLS OPERATING SYSTEM</div>
                <h1>Dashboard</h1>
            </div>

            <div class="ghos-user">
                <div class="ghos-user-text">
                    <strong>Matthew</strong>
                    <span>Administrator</span>
                </div>
                <div class="ghos-avatar">MS</div>
            </div>
        </header>

        <section class="ghos-content">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
