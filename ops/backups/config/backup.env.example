# Installed as /etc/ghos-backup/backup.env with mode 0600.
BACKUP_ROOT=/var/lib/ghos-backup
BACKUP_HOST_TAG=ghos
BACKUP_CONFIG_DIR=/etc/ghos-backup

# Retention is applied during weekly maintenance.
KEEP_HOURLY=24
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Repository used by the monthly database restore drill.
RESTORE_DRILL_REPOSITORY=local
RESTORE_DRILL_DATABASE=ghos

# Optional generic JSON webhook. It receives status, host, phase, and message.
# BACKUP_WEBHOOK_URL=https://example.invalid/private-backup-webhook
