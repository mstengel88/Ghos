#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG_DIR="${GHOS_BACKUP_CONFIG_DIR:-/etc/ghos-backup}"
DATABASES_FILE="$CONFIG_DIR/databases.conf"
VOLUME_EXPORTS_FILE="$CONFIG_DIR/volume-exports.conf"
SOURCE_PATHS_FILE="$CONFIG_DIR/source-paths.conf"
COMPOSE_FILE=/opt/ghos/compose.yml

if [[ "$EUID" -ne 0 ]]; then
  printf 'Run this command with sudo.\n' >&2
  exit 1
fi

for file in "$DATABASES_FILE" "$VOLUME_EXPORTS_FILE" "$SOURCE_PATHS_FILE"; do
  [[ -f "$file" ]] || {
    printf 'Required backup configuration is missing: %s\n' "$file" >&2
    exit 1
  }
done

timestamp="$(date -u +'%Y%m%dT%H%M%SZ')"
for file in "$DATABASES_FILE" "$VOLUME_EXPORTS_FILE" "$SOURCE_PATHS_FILE"; do
  cp -a "$file" "$file.before-$timestamp"
done

upsert_pipe_record() {
  local file="$1"
  local key="$2"
  local record="$3"
  local temporary
  temporary="$(mktemp "$CONFIG_DIR/.backup-config.XXXXXX")"
  awk -F '|' -v key="$key" '$1 != key { print }' "$file" >"$temporary"
  printf '%s\n' "$record" >>"$temporary"
  install -m 0600 "$temporary" "$file"
  rm -f "$temporary"
}

database_exists() {
  local database_name="$1"
  docker compose -f "$COMPOSE_FILE" exec -T postgres \
    psql -U ghosadmin -d postgres -Atc \
      "select 1 from pg_database where datname = '$database_name' and not datistemplate" |
    grep -qx 1
}

while IFS='|' read -r backup_name database_name; do
  database_exists "$database_name" || {
    printf 'Expected local database is missing: %s\n' "$database_name" >&2
    exit 1
  }
  upsert_pipe_record "$DATABASES_FILE" "$backup_name" \
    "$backup_name|$COMPOSE_FILE|postgres|ghosadmin|$database_name|postgres:16"
done <<'EOF'
ghos|ghos
postgres-maintenance|postgres
shipcalc|shipcalc
shopify-bridge|shopify_bridge
EOF

upsert_pipe_record "$VOLUME_EXPORTS_FILE" ghos-data-protection \
  'ghos-data-protection|/opt/ghos/compose.yml|ghos-web|/var/lib/ghos/data-protection'

# /opt/ghos is the required containment boundary. Preserve custom sources
# outside that tree, collapse narrower GHOS entries, and retain comments.
temporary="$(mktemp "$CONFIG_DIR/.source-paths.XXXXXX")"
awk '
  /^[[:space:]]*#/ || /^[[:space:]]*$/ { print; next }
  $0 == "/opt/ghos" { next }
  index($0, "/opt/ghos/") == 1 { next }
  { print }
' "$SOURCE_PATHS_FILE" >"$temporary"
printf '%s\n' /opt/ghos >>"$temporary"
install -m 0600 "$temporary" "$SOURCE_PATHS_FILE"
rm -f "$temporary"

ghos-backup-audit
printf 'Current GHOS workloads are registered for backup. Previous files use suffix .before-%s.\n' "$timestamp"
