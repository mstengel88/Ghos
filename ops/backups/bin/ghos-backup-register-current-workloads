#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

if [[ -f /usr/local/lib/ghos-backup/lib/backup-common.sh ]]; then
  # shellcheck source=/dev/null
  source /usr/local/lib/ghos-backup/lib/backup-common.sh
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=ops/backups/lib/backup-common.sh disable=SC1091
  source "$SCRIPT_DIR/../lib/backup-common.sh"
fi

require_root
load_backup_config

for file in "$DATABASES_FILE" "$VOLUME_EXPORTS_FILE" "$SOURCE_PATHS_FILE"; do
  [[ -f "$file" ]] || {
    printf 'Required backup configuration is missing: %s\n' "$file" >&2
    exit 1
  }
done

timestamp="$(date -u +'%Y%m%dT%H%M%SZ')"
for file in "$DATABASES_FILE" "$VOLUME_EXPORTS_FILE" "$SOURCE_PATHS_FILE"; do
  cp -a "$file" "$file.before-$timestamp"
done

upsert_pipe_record() {
  local file="$1"
  local key="$2"
  local record="$3"
  local temporary
  temporary="$(mktemp "$(dirname "$file")/.backup-config.XXXXXX")"
  awk -F '|' -v key="$key" '$1 != key { print }' "$file" >"$temporary"
  printf '%s\n' "$record" >>"$temporary"
  install -m 0600 "$temporary" "$file"
  rm -f "$temporary"
}

database_exists() {
  local compose_file="$1"
  local compose_service="$2"
  local database_user="$3"
  local database_name="$4"
  docker compose -f "$compose_file" exec -T "$compose_service" \
    psql -U "$database_user" -d postgres -Atc \
      "select 1 from pg_database where datname = '$database_name' and not datistemplate" |
    grep -qx 1
}

discover_application_database() {
  local compose_file="$1"
  local compose_service="$2"
  local database_user="$3"
  local databases

  databases="$(
    docker compose -f "$compose_file" exec -T "$compose_service" \
      psql -U "$database_user" -d postgres -Atc \
        "select datname from pg_database where not datistemplate and datname <> 'postgres' order by datname"
  )"

  if [[ -z "$databases" ]]; then
    printf 'No application database was found for Compose service %s in %s\n' \
      "$compose_service" "$compose_file" >&2
    return 1
  fi

  if [[ "$(printf '%s\n' "$databases" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')" != 1 ]]; then
    printf 'Expected one application database for Compose service %s in %s; found:\n%s\n' \
      "$compose_service" "$compose_file" "$databases" >&2
    return 1
  fi

  printf '%s\n' "$databases"
}

while IFS='|' read -r backup_name compose_file compose_service database_user database_name postgres_image; do
  database_exists "$compose_file" "$compose_service" "$database_user" "$database_name" || {
    printf 'Expected local database is missing: %s\n' "$database_name" >&2
    exit 1
  }
  upsert_pipe_record "$DATABASES_FILE" "$backup_name" \
    "$backup_name|$compose_file|$compose_service|$database_user|$database_name|$postgres_image"
done <<'EOF'
ghos|/opt/ghos/compose.yml|postgres|ghosadmin|ghos|postgres:16
postgres-maintenance|/opt/ghos/compose.yml|postgres|ghosadmin|postgres|postgres:16
shipcalc|/opt/ghos/compose.yml|postgres|ghosadmin|shipcalc|postgres:16
shopify-bridge|/opt/ghos/compose.yml|postgres|ghosadmin|shopify_bridge|postgres:16
EOF


# Operations may intentionally retain a timestamped database name during a
# rollback window. Register the database the healthy runtime is actually using
# instead of assuming that it is always named "operations".
operations_database="$(
  discover_application_database \
    /opt/ghos/ops/supabase-operations/compose.yml \
    db \
    postgres
)"
upsert_pipe_record "$DATABASES_FILE" operations \
  "operations|/opt/ghos/ops/supabase-operations/compose.yml|db|postgres|$operations_database|supabase/postgres:17.6.1.136"

upsert_pipe_record "$VOLUME_EXPORTS_FILE" ghos-data-protection \
  'ghos-data-protection|/opt/ghos/compose.yml|ghos-web|/var/lib/ghos/data-protection'

# /opt/ghos is the required containment boundary. Preserve custom sources
# outside that tree, collapse narrower GHOS entries, and retain comments.
temporary="$(mktemp "$(dirname "$SOURCE_PATHS_FILE")/.source-paths.XXXXXX")"
awk '
  /^[[:space:]]*#/ || /^[[:space:]]*$/ { print; next }
  $0 == "/opt/ghos" { next }
  index($0, "/opt/ghos/") == 1 { next }
  { print }
' "$SOURCE_PATHS_FILE" >"$temporary"
printf '%s\n' /opt/ghos >>"$temporary"
install -m 0600 "$temporary" "$SOURCE_PATHS_FILE"
rm -f "$temporary"

ghos-backup-audit
printf 'Current GHOS workloads are registered for backup. Previous files use suffix .before-%s.\n' "$timestamp"
