#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

if [[ -f /usr/local/lib/ghos-backup/lib/backup-common.sh ]]; then
  # shellcheck source=/dev/null
  source /usr/local/lib/ghos-backup/lib/backup-common.sh
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=ops/backups/lib/backup-common.sh
  source "$SCRIPT_DIR/../lib/backup-common.sh"
fi

require_root
require_command docker
require_command restic
require_command flock
require_command python3
load_backup_config

ensure_private_directory "$BACKUP_ROOT"
exec 9>"$LOCK_FILE"
flock -n 9 || die "A GHOS backup or maintenance operation is already running."

repository_name="${RESTORE_DRILL_REPOSITORY:-local}"
database_name="${RESTORE_DRILL_DATABASE:-all}"
restore_root="$(mktemp -d "$BACKUP_ROOT/restore-drill.XXXXXXXX")"
container_name=""
drill_password="restore-drill-only"

wait_for_final_postgres() {
  local candidate_container="$1"
  local init_process=""

  # PostgreSQL images start a temporary server while their entrypoint performs
  # initialization. pg_isready can succeed against that server immediately
  # before it is intentionally stopped, which previously made the drill race
  # into "the database system is shutting down". The entrypoint execs the
  # final postgres server as PID 1 only after initialization is complete.
  for _ in $(seq 1 120); do
    if [[ "$(docker inspect --format '{{.State.Running}}' "$candidate_container" 2>/dev/null || true)" != true ]]; then
      break
    fi

    init_process="$(docker exec "$candidate_container" cat /proc/1/comm 2>/dev/null || true)"
    case "$init_process" in
      postgres*|.postgres-wrapp*)
        if docker exec "$candidate_container" pg_isready -U postgres >/dev/null 2>&1; then
          return 0
        fi
        ;;
    esac

    sleep 2
  done

  printf "PostgreSQL container '%s' did not reach final-server readiness.\n" \
    "$candidate_container" >&2
  docker logs --tail 100 "$candidate_container" >&2 2>/dev/null || true
  return 1
}

cleanup() {
  [[ -z "$container_name" ]] || docker rm -f "$container_name" >/dev/null 2>&1 || true
  if [[ -d "$restore_root" && "$restore_root" == "$BACKUP_ROOT"/restore-drill.* ]]; then
    find "$restore_root" -depth -delete
  fi
}
trap cleanup EXIT

load_repository "$repository_name"
repository_exists || die "Repository '$repository_name' is not initialized."

# Every backup uses a new run directory, so Restic's wildcard restore filters
# are not a reliable way to recover the logical dumps. Select the newest
# snapshot explicitly, read its recorded run root, and extract each required
# file by its exact snapshot path instead.
snapshot_selection="$({
  restic snapshots \
    --host "$BACKUP_HOST_TAG" \
    --tag ghos-automatic \
    --json
} | python3 -c '
import json
import os
import sys

backup_root = os.path.normpath(sys.argv[1])
run_prefix = backup_root + "/runs/"
snapshots = json.load(sys.stdin)
candidates = []

for snapshot in snapshots:
    run_paths = [
        os.path.normpath(path)
        for path in snapshot.get("paths", [])
        if os.path.normpath(path).startswith(run_prefix)
    ]
    if run_paths:
        candidates.append((snapshot.get("time", ""), snapshot.get("id", ""), run_paths[0]))

if not candidates:
    raise SystemExit("No GHOS automatic snapshot contains a backup run directory.")

_, snapshot_id, run_path = max(candidates)
if not snapshot_id:
    raise SystemExit("Latest GHOS automatic snapshot does not have an ID.")

print(snapshot_id)
print(run_path)
' "$BACKUP_ROOT")" || die "Unable to select the latest GHOS automatic snapshot."

mapfile -t snapshot_details <<<"$snapshot_selection"
(( ${#snapshot_details[@]} == 2 )) ||
  die "Unable to identify the latest GHOS backup snapshot and run directory."
snapshot_id="${snapshot_details[0]}"
snapshot_run_path="${snapshot_details[1]}"
staged_database_dir="$restore_root/databases"
ensure_private_directory "$staged_database_dir"

# Refuse to proceed when the snapshot's logical-dump manifest and the active
# database registry disagree. This produces one complete diagnostic instead of
# stopping at the first missing dump and makes configuration drift obvious.
missing_backups=()
mapfile -t database_entries < <(each_config_line "$DATABASES_FILE")
(( ${#database_entries[@]} > 0 )) ||
  die "No databases are registered in $DATABASES_FILE"

for database_entry in "${database_entries[@]}"; do
  IFS='|' read -r backup_name _ <<<"$database_entry"
  [[ -n "$backup_name" ]] || continue
  dump_file="$staged_database_dir/$backup_name.dump"
  image_file="$staged_database_dir/$backup_name-postgres-image"
  snapshot_dump_path="$snapshot_run_path/databases/$backup_name.dump"
  snapshot_image_path="$snapshot_run_path/databases/$backup_name-postgres-image"

  if ! restic dump --quiet "$snapshot_id" "$snapshot_dump_path" --target "$dump_file" ||
     ! restic dump --quiet "$snapshot_id" "$snapshot_image_path" --target "$image_file" ||
     [[ ! -s "$dump_file" || ! -s "$image_file" ]]; then
    find "$dump_file" "$image_file" -maxdepth 0 -type f -delete 2>/dev/null || true
    missing_backups+=("$backup_name")
  fi
done

if (( ${#missing_backups[@]} > 0 )); then
  die "Snapshot ${snapshot_id:0:8} is incomplete for the active database registry; missing logical backups: ${missing_backups[*]}"
fi

configured_names=()
for database_entry in "${database_entries[@]}"; do
  IFS='|' read -r backup_name _ <<<"$database_entry"
  if [[ "$database_name" == all || "$database_name" == "$backup_name" ]]; then
    configured_names+=("$backup_name")
  fi
done
(( ${#configured_names[@]} > 0 )) ||
  die "No configured database matches restore drill selection '$database_name'."

for backup_name in "${configured_names[@]}"; do
  dump_file="$staged_database_dir/$backup_name.dump"
  image_file="$staged_database_dir/$backup_name-postgres-image"
  [[ -n "$dump_file" && -s "$dump_file" ]] || die "Latest snapshot does not contain $backup_name.dump"
  [[ -n "$image_file" && -s "$image_file" ]] || die "Latest snapshot does not identify the PostgreSQL image for $backup_name."
  postgres_image="$(cat "$image_file")"
  restore_user="postgres"
  case "$postgres_image" in
    supabase/postgres:*)
      # Supabase Vault objects are owned by supabase_admin and deliberately
      # reject writes from the image's non-superuser postgres role. The drill
      # runs only inside a disposable container, so use the image's built-in
      # administrative role to validate protected Vault rows as well.
      restore_user="supabase_admin"
      ;;
  esac
  container_name="ghos-restore-drill-${backup_name//[^a-zA-Z0-9_.-]/-}-$(date +%s)"

  docker run -d --rm \
    --name "$container_name" \
    -e "POSTGRES_PASSWORD=$drill_password" \
    "$postgres_image" >/dev/null

  wait_for_final_postgres "$container_name" ||
    die "Disposable PostgreSQL container failed to become ready for '$backup_name'."

  # Never restore into a database cloned from template1. Supabase images put
  # extensions such as pg_net in template1, and restoring their COMMENT or
  # metadata as another administrative role then fails an ownership check.
  # A template0 database is empty; restoring as its selected owner lets the
  # dump create and own its extensions and Vault objects consistently.
  docker exec "$container_name" \
    createdb -U postgres --template=template0 --owner="$restore_user" restore_drill
  docker exec -i "$container_name" \
    pg_restore --exit-on-error --no-owner --no-acl -U "$restore_user" -d restore_drill <"$dump_file"
  docker exec "$container_name" \
    psql -v ON_ERROR_STOP=1 -U "$restore_user" -d restore_drill \
    -c 'select current_database(), count(*) as schema_count from information_schema.schemata;' >/dev/null
  docker rm -f "$container_name" >/dev/null
  container_name=""
  printf "Restore drill passed for database '%s'.\n" "$backup_name"
done

write_status success restore-drill \
  "All selected databases restored and queried from repository '$repository_name'."
notify_status success restore-drill \
  "All selected databases restored and queried from repository '$repository_name'." || true
printf "Restore drill passed for %d database(s) from repository '%s'.\n" \
  "${#configured_names[@]}" "$repository_name"
