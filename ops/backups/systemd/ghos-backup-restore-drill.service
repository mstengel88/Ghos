[Unit]
Description=Restore the latest GHOS database into a disposable PostgreSQL container
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=RESTIC_CACHE_DIR=/var/lib/ghos-backup/cache
ExecStart=/usr/local/sbin/ghos-backup-restore-drill
Nice=15
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ghos-backup /var/run/docker.sock
ReadOnlyPaths=/etc/ghos-backup
