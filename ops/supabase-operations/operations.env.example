# Generated secrets belong in .env and must never be committed.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
ANON_KEY=replace-with-an-hs256-anon-jwt
SERVICE_ROLE_KEY=replace-with-an-hs256-service-role-jwt

# The gateway stays loopback-only until a Cloudflare hostname is approved.
OPERATIONS_API_PORT=18000
SUPABASE_PUBLIC_URL=http://127.0.0.1:18000
API_EXTERNAL_URL=http://127.0.0.1:18000/auth/v1
SITE_URL=http://127.0.0.1:8084
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:8084/**

# Preserve existing accounts; do not allow public account creation at staging.
DISABLE_SIGNUP=true
JWT_EXPIRY=3600

# Configure real SMTP privately before password-reset acceptance testing.
SMTP_ADMIN_EMAIL=admin@example.invalid
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_SENDER_NAME=Green Hills Supply
