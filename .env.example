POSTGRES_DB=ghos
POSTGRES_USER=ghosadmin
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
GHOS_BOOTSTRAP_TOKEN=REPLACE_WITH_A_ONE_TIME_RANDOM_SETUP_CODE
SHOPIFY_STORE_DOMAIN=darfaz-2e.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional server-managed alternative to the encrypted GHOS settings form.
SHOPIFY_DRAFT_ORDER_CLIENT_ID=
SHOPIFY_DRAFT_ORDER_CLIENT_SECRET=
DISPATCH_SYNC_ENABLED=true
DISPATCH_SYNC_INTERVAL_MINUTES=5
DISPATCH_SYNC_INITIAL_DELAY_SECONDS=30
GOOGLE_MAPS_API_KEY=
# Browser-restricted key with Maps JavaScript API and Places API enabled.
# Allow the local and Tailscale GHOS origins as HTTP referrers. GHOS never
# exposes GOOGLE_MAPS_API_KEY to the browser.
GOOGLE_MAPS_BROWSER_API_KEY=
# Product-only fallback tax rules. GHOS first asks Shopify to calculate the
# address-specific rate and caches it for 30 days, matching Dispatch v2.
# These values apply when Shopify is unavailable or the address is incomplete.
QUOTE_TAX_RATE=0.05
QUOTE_MILWAUKEE_CITY_TAX_RATE=0.079
QUOTE_MILWAUKEE_COUNTY_TAX_RATE=0.059
QUOTE_MILWAUKEE_COUNTY_CITIES=Bayside,Brown Deer,Cudahy,Fox Point,Franklin,Glendale,Greendale,Greenfield,Hales Corners,Oak Creek,River Hills,Shorewood,South Milwaukee,St. Francis,Wauwatosa,West Allis,West Milwaukee,Whitefish Bay
QUOTE_MILWAUKEE_COUNTY_POSTAL_CODES=
QUOTE_MILWAUKEE_COUNTY_POSTAL_PREFIXES=
# Optional JSON array for additional city, ZIP, or address matching rules.
QUOTE_TAX_RATE_RULES=
DISPATCH_QUOTE_SUPABASE_URL=
DISPATCH_QUOTE_SERVICE_ROLE_KEY=
DISPATCH_QUOTE_REFRESH_MINUTES=30
